<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The App Store build keeps its backup in iCloud Drive › Haven. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.net.haven.app</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudDocuments</string>
    </array>
    <!-- Media servers, Live TV and accounts shared with the person's other
         devices (iPhone, iPad, Apple TV: the same app id) through iCloud's
         key-value storage. -->
    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
    <string>$(TeamIdentifierPrefix)net.haven.app</string>
    <key>com.apple.developer.ubiquity-container-identifiers</key>
    <array>
        <string>iCloud.net.haven.app</string>
    </array>
</dict>
</plist>
