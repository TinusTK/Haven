<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+: one full-bleed picture that each phone cuts to its own icon
     shape (circle, squircle, rounded square). The ring sits inside the
     smallest shape; the picture is in mipmap-*/ic_launcher_background.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
