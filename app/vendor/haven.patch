         let had_delay = mouse_input_state.has_delayed_event();
 
         let last_top_item = mouse_input_state.top_item_including_delayed();
-        if released_event {
+        // Haven patch: a press a Flickable is holding back is also handed on
+        // as soon as the pointer moves, not only on release or after the
+        // delay. Otherwise a Flickable inside it (a row that scrolls
+        // sideways) sees the moves of a quick swipe before its press,
+        // ignores them and then jumps.
+        let moved_event = matches!(event, MouseEvent::Moved { .. });
+        if released_event || (had_delay && moved_event) {
             mouse_input_state =
