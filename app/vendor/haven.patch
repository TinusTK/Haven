         }
--- a/items/flickable.rs	2006-07-24 10:51:28
+++ b/items/flickable.rs	2026-11-24 01:14:47
@@ -809,10 +809,15 @@
 
         // We should capture the mouse movement, if the flickable can move in this
         // axis, and the mouse has moved more than the threshold in this axis.
-        ((content_width > flickable_width || flick.content_x() != zero)
-            && abs(mouse_delta.x_length()) > DISTANCE_THRESHOLD)
-            || ((content_height > flickable_height || flick.content_y() != zero)
-                && abs(mouse_delta.y_length()) > DISTANCE_THRESHOLD)
+        let can_x = content_width > flickable_width || flick.content_x() != zero;
+        let can_y = content_height > flickable_height || flick.content_y() != zero;
+        let (dx, dy) = (abs(mouse_delta.x_length()), abs(mouse_delta.y_length()));
+        // Haven patch: a Flickable that moves along one axis only takes a
+        // drag that went mostly along that axis. Without this the page
+        // takes a sideways swipe on a row inside it as soon as the finger
+        // dips 8 px, however far it went sideways.
+        (can_x && dx > DISTANCE_THRESHOLD && (can_y || dx >= dy))
+            || (can_y && dy > DISTANCE_THRESHOLD && (can_x || dy >= dx))
     }
 
