import { Button, ComboBox, LineEdit, ListView, Palette, ScrollView, Switch } from "std-widgets.slint";
// Haven's own type: Figtree for text and Pixelify Sans for headings
// (both SIL Open Font License). The files have the digits taken out of
// their character maps, so numbers keep the system's own font.
import "../../../assets/fonts/Figtree-Regular.ttf";
import "../../../assets/fonts/Figtree-Medium.ttf";
import "../../../assets/fonts/Figtree-SemiBold.ttf";
import "../../../assets/fonts/Figtree-Bold.ttf";
import "../../../assets/fonts/Figtree-ExtraBold.ttf";
import "../../../assets/fonts/PixelifySans-Medium.ttf";
import "../../../assets/fonts/PixelifySans-Bold.ttf";

// One title in a shelf. `has-image` is false until its poster has loaded.
export struct Poster {
    id: string,
    // Content type: "movie", "series"…
    kind: string,
    title: string,
    year: string,
    image: image,
    has-image: bool,
    // Continue Watching only: the film or episode to carry on with, and
    // how much of it has been watched (0 to 1).
    video: string,
    progress: float,
    // Watched to the end: a gold tick shows on the poster.
    watched: bool,
}

// One line of a release's notes: a bullet point (maybe under another)
// or a plain line of text; an empty line leaves a gap.
export struct NoteLine {
    bullet: bool,
    deep: bool,
    text: string,
}

// One catalogue from an add-on, shown as a row of posters on Home.
export struct Shelf {
    title: string,
    source: string,
    loading: bool,
    error: string,
    items: [Poster],
}

// The open title's page. Text fields are empty until its details load.
export struct Detail {
    title: string,
    // Year, runtime, rating and genres on one line.
    facts: string,
    description: string,
    cast: string,
    director: string,
    poster: image,
    has-poster: bool,
    background: image,
    has-background: bool,
    loading: bool,
    error: string,
    // The title is on the watchlist.
    saved: bool,
    // A film watched to the end.
    watched: bool,
    // The title is a film (it can be marked watched as a whole).
    film: bool,
}

export struct EpisodeRow {
    id: string,
    number: string,
    title: string,
    date: string,
    selected: bool,
    // Watched to the end.
    watched: bool,
}

export struct StreamRow {
    source: string,
    name: string,
    detail: string,
    // How it is delivered: "Direct", "Web page", "YouTube", "Torrent".
    kind: string,
    // Haven's own player can open it.
    playable: bool,
    // Who provided it: an add-on's name, or for a media server the
    // add-on it got the stream from (else the server itself).
    group: string,
    // The rest of the detail, on a second line in the title page's panel.
    detail2: string,
    // Its place among the rows of its provider.
    group-at: int,
    // Among those its provider shows for now.
    shown: bool,
    // The provider's heading, on its first row only.
    heading: string,
    // How many more the provider has, on its last shown row only.
    more: int,
    // The file's size ("12.3 GB"), shown beside the name; empty if unknown.
    size: string,
    // How many are sharing it (seeders); empty if unknown.
    seeders: string,
}

// Something coming out, on the Calendar page.
export struct CalendarEntry {
    kind: string,
    id: string,
    title: string,
    // "S3 E5 · Its name" for an episode; empty for a film.
    label: string,
    // The episode's id, to open it by; empty for a film.
    video: string,
    // The local time of day, if known.
    time: string,
    // This episode (or film) has been watched.
    watched: bool,
}

// One day's square of the month.
export struct CalendarDay {
    number: int,
    in-month: bool,
    today: bool,
    entries: [CalendarEntry],
    // How many more come out that day than the square names.
    more: int,
    // Everything that comes out that day (a phone lists the day picked).
    all: [CalendarEntry],
    // "Tuesday 25 November", heading the day picked on a phone.
    long-name: string,
}

// One line of the month's list; the first of a day carries the day.
export struct AgendaRow {
    heading: string,
    today: bool,
    past: bool,
    entry: CalendarEntry,
}

// A film or episode in the Library's Downloads. `section` ("Films" or
// "Series") and `group` (a series' name) are set on the first row under
// them only.
export struct DownloadRow {
    id: int,
    section: string,
    group: string,
    title: string,
    status: string,
    progress: float,
    done: bool,
    running: bool,
    failed: bool,
}

// A title in Home's banner.
export struct HeroSlide {
    id: string,
    kind: string,
    title: string,
    // "★ 8.2  •  2026  •  Horror, Thriller  •  Film".
    facts: string,
    description: string,
    image: image,
    has-image: bool,
}

// A film or episode to carry on with, in Home's Continue Watching row.
export struct ContinueCard {
    id: string,
    kind: string,
    video: string,
    title: string,
    // The episode's name (or its number); empty for a film.
    episode: string,
    // "S03E06"; empty for a film.
    badge: string,
    // Aired episodes still to watch, from this one on; 0 shows nothing.
    left: int,
    // How much of it has been watched, 0 to 1.
    progress: float,
    image: image,
    has-image: bool,
}

// Something coming out soon, in Home's Upcoming row.
export struct UpcomingCard {
    id: string,
    kind: string,
    // The episode's id, to open it by; empty for a film.
    video: string,
    title: string,
    // The episode's name (or its number).
    episode: string,
    // "S01E01"; empty for a film.
    badge: string,
    // "Today", "In 6 days", "Dec 25".
    when: string,
    // Within a week: the date shows in the accent colour.
    soon: bool,
    image: image,
    has-image: bool,
}

// A provider of places to watch, with how many it gave.
export struct StreamGroup {
    name: string,
    count: int,
}

// One audio or subtitle track of what is playing.
export struct TrackRow {
    id: int,
    label: string,
    selected: bool,
}

// One television channel or radio station in a list.
export struct ChannelRow {
    // Its place among all channels, which is what playing it takes.
    index: int,
    name: string,
    group: string,
    // In one of the user's Favourites groups.
    starred: bool,
}

// One line of the list of categories beside the channels.
export struct CategoryRow {
    // What choosing it asks for: "" every channel, "g:<name>" a group of
    // the playlist, "f:<name>" one of the user's Favourites groups.
    key: string,
    label: string,
    count: int,
    favourite: bool,
}

// A Favourites group in the chooser, ticked if it holds the channel.
export struct FavPick {
    name: string,
    has: bool,
}

// One line of the list of sources on Explore: a heading (where the
// sources below come from) or a source.
export struct ExploreRow {
    index: int,
    label: string,
    header: bool,
}

// A service that has the open title, and how: "Subscription", "Rent"…
export struct OfferRow {
    name: string,
    ways: string,
    // "Stream", "Free", "Rent" or "Buy" on the first tile of its group.
    group: string,
    // Haven's own tile for the service: its letters and colours.
    letters: string,
    tint: color,
    ink: color,
}

// An add-on a media server uses and shares with its owner.
export struct SharedAddonRow {
    index: int,
    name: string,
    server: string,
    installed: bool,
}

// A playlist or an Xtream Codes account the user added.
export struct SourceRow {
    url: string,
    name: string,
    channels: int,
    // What to show under the name: the playlist's address, or for an
    // account who it belongs to (never its password).
    detail: string,
    // Switched on. Off, it stays here but its channels are not shown.
    enabled: bool,
    // An Xtream Codes account's server: 0 nothing to show, 1 being
    // checked, 2 online, 3 offline.
    state: int,
}

// A media server the user signed in to.
export struct ServerRow {
    id: int,
    name: string,
    // "Jellyfin", "Emby" or "Plex".
    kind: string,
    address: string,
    // 0 still checking, 1 online, 2 offline.
    state: int,
    // Switched on. Off, Haven stays signed in but leaves it alone.
    enabled: bool,
}

// Trakt or Simkl in Settings.
export struct TrackingRow {
    // 0 Trakt, 1 Simkl.
    service: int,
    name: string,
    state: string,
    connected: bool,
    // Its keys are set, so signing in can be tried.
    can-connect: bool,
}

// A tracking account in Settings > Sync options.
export struct SyncAccount {
    // 0 Trakt, 1 Simkl.
    service: int,
    name: string,
    detail: string,
    linked: bool,
    // Linked and its sync is on.
    on: bool,
}

export struct AddonRow {
    url: string,
    name: string,
    description: string,
    version: string,
    catalogs: int,
    // Switched on. Off, it stays installed but is not asked for anything.
    enabled: bool,
}

export global Theme {
    in-out property <bool> dark: true;
    out property <color> background: dark ? #0d0f14 : #f3f4f7;
    out property <color> surface: dark ? #151821 : #ffffff;
    out property <color> border: dark ? #232733 : #dfe2ea;
    out property <color> hover: dark ? #1c202b : #eceef4;
    out property <color> selected: dark ? #262b3a : #e1e6f5;
    out property <color> text: dark ? #eef0f6 : #171a22;
    out property <color> text-dim: dark ? #9aa1b3 : #5d6475;
    out property <color> accent: dark ? #f2c66d : #b9851a;
    // Stands out on purpose: the "Report an issue" pill.
    out property <color> alert: dark ? #e5484d : #d13438;
    // The type headings are set in.
    out property <string> heading-font: "Pixelify Sans";
}



// A line icon drawn on a 24-unit square, by name.
component Icon inherits Rectangle {
    in property <string> name;
    in property <color> tint: Theme.text;
    in property <length> size: 24px;
    in property <length> stroke: 2px;
    width: root.size;
    height: root.size;
    accessible-role: none;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.tint;
        stroke-width: root.stroke;
        fill: root.name == "play" ? root.tint : transparent;
        commands: root.name == "home" ? "M3 10.5 L12 3 L21 10.5 M5.5 9 V20 a1 1 0 0 0 1 1 H10 V15 H14 V21 H17.5 a1 1 0 0 0 1 -1 V9" : root.name == "explore" ? "M12 2.5 a9.5 9.5 0 1 0 0 19 a9.5 9.5 0 1 0 0 -19 Z M15.8 8.2 L13.6 13.6 L8.2 15.8 L10.4 10.4 Z" : root.name == "library" ? "M4 4 H8 V20 H4 Z M10 4 H14 V20 H10 Z M15.6 5.2 L19.4 4.2 L22 19 L18.2 20 Z" : root.name == "livetv" ? "M3 7 H21 a1 1 0 0 1 1 1 V18 a1 1 0 0 1 -1 1 H3 a1 1 0 0 1 -1 -1 V8 a1 1 0 0 1 1 -1 Z M8 3 L12 7 L16 3" : root.name == "calendar" ? "M4 5 H20 a1 1 0 0 1 1 1 V20 a1 1 0 0 1 -1 1 H4 a1 1 0 0 1 -1 -1 V6 a1 1 0 0 1 1 -1 Z M3 10 H21 M8 3 V7 M16 3 V7" : root.name == "search" ? "M10.5 3.5 a7 7 0 1 0 0 14 a7 7 0 1 0 0 -14 Z M15.5 15.5 L21 21" : root.name == "settings" ? "M18.88 9.87 L21.66 10.34 L21.66 13.66 L18.88 14.13 L18.37 15.36 L20.00 17.66 L17.66 20.00 L15.36 18.37 L14.13 18.88 L13.66 21.66 L10.34 21.66 L9.87 18.88 L8.64 18.37 L6.34 20.00 L4.00 17.66 L5.63 15.36 L5.12 14.13 L2.34 13.66 L2.34 10.34 L5.12 9.87 L5.63 8.64 L4.00 6.34 L6.34 4.00 L8.64 5.63 L9.87 5.12 L10.34 2.34 L13.66 2.34 L14.13 5.12 L15.36 5.63 L17.66 4.00 L20.00 6.34 L18.37 8.64 Z M12 9 a3 3 0 1 0 0 6 a3 3 0 1 0 0 -6 Z" : root.name == "download" ? "M12 3 V15 M7 10 L12 15 L17 10 M4 20 H20" : root.name == "trash" ? "M4 7 H20 M9 7 V4 H15 V7 M6 7 L7 21 H17 L18 7" : root.name == "play" ? "M7 4 L20 12 L7 20 Z" : root.name == "pause" ? "M8 5 V19 M16 5 V19" : root.name == "folder" ? "M3 6 a1 1 0 0 1 1 -1 H9 L11 7 H20 a1 1 0 0 1 1 1 V18 a1 1 0 0 1 -1 1 H4 a1 1 0 0 1 -1 -1 Z" : root.name == "check" ? "M5 12.5 L10 17.5 L19 7" : root.name == "close" ? "M6 6 L18 18 M18 6 L6 18" : root.name == "back" ? "M15 5 L8 12 L15 19" : root.name == "forward" ? "M9 5 L16 12 L9 19" : root.name == "radio" ? "M4 9 H20 a1 1 0 0 1 1 1 V19 a1 1 0 0 1 -1 1 H4 a1 1 0 0 1 -1 -1 V10 a1 1 0 0 1 1 -1 Z M6 9 L17 4 M15.5 12.5 a2.5 2.5 0 1 0 0 5 a2.5 2.5 0 1 0 0 -5 Z M6 13 H11 M6 16 H11" : root.name == "account" ? "M12 4 a4 4 0 1 0 0 8 a4 4 0 1 0 0 -8 Z M4 21 a8 8 0 0 1 16 0" : root.name == "server" ? "M4 4 H20 V10 H4 Z M4 14 H20 V20 H4 Z M7 7 H8 M7 17 H8" : root.name == "addon" ? "M5 8 H9 a2 2 0 1 1 4 0 H17 V12 a2 2 0 1 1 0 4 V20 H5 Z" : root.name == "info" ? "M12 3 a9 9 0 1 0 0 18 a9 9 0 1 0 0 -18 Z M12 11 V16 M12 7.5 V8" : root.name == "general" ? "M4 6 H20 M4 12 H20 M4 18 H20 M9 4 V8 M15 10 V14 M7 16 V20" : root.name == "storage" ? "M4 5 H20 V19 H4 Z M4 14 H20 M7 16.5 H8" : root.name == "paste" ? "M8 5 H6 a1 1 0 0 0 -1 1 V20 a1 1 0 0 0 1 1 H18 a1 1 0 0 0 1 -1 V6 a1 1 0 0 0 -1 -1 H16 M9 3 H15 V7 H9 Z M9 12 H15 M9 16 H13" : root.name == "sync" ? "M20 11 a8 8 0 0 0 -14.5 -4.5 M4 4 V8 H8 M4 13 a8 8 0 0 0 14.5 4.5 M20 20 V16 H16" : root.name == "plus" ? "M12 5 V19 M5 12 H19" : root.name == "link" ? "M10 14 L14 10 M8.5 11.5 L6.5 13.5 a3 3 0 0 0 4 4 L12.5 15.5 M15.5 12.5 L17.5 10.5 a3 3 0 0 0 -4 -4 L11.5 8.5" : root.name == "player" ? "M3 5 H21 V19 H3 Z M10 9 L15 12 L10 15 Z" : "";
    }
}

// Watched: a gold tick in a round pill.
component WatchedTick inherits Rectangle {
    in property <length> size: 22px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: #11131acc;
    border-width: 1.5px;
    border-color: Theme.accent;
    accessible-role: image;
    accessible-label: "Watched";
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: "check";
        size: root.size * 0.64;
        stroke: 2.5px;
        tint: Theme.accent;
    }
}

// Pull to refresh, built into a page's own scrolling (a gesture layer
// over the page swallowed its scrolling on phones): the page keeps this
// strip just above its top, scrolled out of sight. Pulling past the top
// shows it; once it is all in view the page refreshes, and the strip
// turns until the refresh is done.
component RefreshStrip inherits Rectangle {
    // How much of the strip shows, 0 to 1.
    in property <float> reveal;
    in property <bool> busy;
    accessible-role: text;
    accessible-label: root.busy ? "Refreshing" : "Pull down to refresh";
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 10px;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: Theme.surface;
        border-width: 1.5px;
        border-color: root.busy || root.reveal >= 1 ? Theme.accent : Theme.border;
        opacity: root.busy ? 1 : clamp(root.reveal * 1.4 - 0.2, 0, 1);
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: "sync";
            size: 22px;
            tint: Theme.accent;
            transform-rotation: root.busy ? animation-tick() / 0.9s * 360deg : root.reveal * 270deg;
        }
    }
}

// One button of the navigation bar: an icon over its name, on a
// rounded highlight when it is the page showing.
component NavButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 56px;
    border-radius: 28px;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    animate background { duration: 150ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 22px;
                tint: root.selected ? Theme.text : Theme.text-dim;
            }
        }
        if root.label != "": Text {
            text: root.label;
            color: root.selected ? Theme.text : Theme.text-dim;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
}

// A round button with an icon (and a name for screen readers).
component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    in property <length> size: 36px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.active || touch.has-hover ? Theme.accent : Theme.selected;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        name: root.icon;
        size: root.size * 0.5;
        tint: root.active || touch.has-hover ? (Theme.dark ? #171a22 : #ffffff) : Theme.accent;
    }
}

// A segmented switch of two to four choices, like Month / Week.
component Segments inherits Rectangle {
    in property <[string]> labels;
    in-out property <int> current;
    callback chosen(int);
    height: 34px;
    width: root.labels.length * 92px + 8px;
    border-radius: 17px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    for label[index] in root.labels: Rectangle {
        x: 4px + index * 92px;
        y: 3px;
        width: 92px;
        height: parent.height - 6px;
        border-radius: self.height / 2;
        background: index == root.current ? Theme.accent : seg-touch.has-hover ? Theme.hover : transparent;
        accessible-role: button;
        accessible-label: label;
        seg-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.current = index;
                root.chosen(index);
            }
        }
        Text {
            text: label;
            color: index == root.current ? (Theme.dark ? #171a22 : #ffffff) : Theme.text;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A group of settings on one card, with a heading over it.
component SettingsCard inherits VerticalLayout {
    in property <string> title;
    in property <string> note;
    spacing: 8px;
    if root.title != "": Text {
        text: root.title;
        color: Theme.text-dim;
        font-size: 12px;
        font-weight: 700;
    }
    Rectangle {
        border-radius: 14px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            @children
        }
    }
    if root.note != "": Text {
        text: root.note;
        color: Theme.text-dim;
        font-size: 12px;
        wrap: word-wrap;
    }
}

// One film or episode in the Library's Downloads.
component DownloadItem inherits Rectangle {
    in property <DownloadRow> item;
    callback play();
    callback toggle();
    callback remove();
    height: 64px;
    border-radius: 12px;
    background: touch.has-hover && root.item.done ? Theme.hover : Theme.surface;
    border-width: 1px;
    border-color: touch.has-hover && root.item.done ? Theme.accent : Theme.border;
    touch := TouchArea {
        mouse-cursor: root.item.done ? pointer : default;
        clicked => {
            if (root.item.done) {
                root.play();
            }
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 5px;
            Text {
                text: root.item.title;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.item.status;
                color: root.item.failed ? (Theme.dark ? #ff8b8b : #b3261e) : Theme.text-dim;
                font-size: 12px;
                overflow: elide;
            }
            if !root.item.done: Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.border;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.item.progress, 0, 1);
                    border-radius: 2px;
                    background: Theme.accent;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                if root.item.done: IconButton {
                    icon: "play";
                    label: "Play " + root.item.title;
                    clicked => { root.play(); }
                }
                if !root.item.done: IconButton {
                    icon: root.item.running ? "pause" : "download";
                    label: root.item.running ? "Pause" : "Carry on";
                    clicked => { root.toggle(); }
                }
                IconButton {
                    icon: "trash";
                    label: "Delete " + root.item.title;
                    clicked => { root.remove(); }
                }
            }
        }
    }
}


// The main button of a form, in Haven's own accent colour.
component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    min-width: pb-label.preferred-width + 36px;
    height: 34px;
    border-radius: 17px;
    background: !root.enabled ? Theme.selected : pb-touch.pressed ? Theme.accent.darker(0.15) : pb-touch.has-hover ? Theme.accent.brighter(0.08) : Theme.accent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    pb-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    pb-label := Text {
        text: root.text;
        color: root.enabled ? (Theme.dark ? #171a22 : #ffffff) : Theme.text-dim;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// What kind of screen Haven runs on, for parts deep inside components.
export global Device {
    // A phone or tablet: no keyboard shortcuts, so fields get a Paste button.
    in-out property <bool> touch;
}

// A one-line text field. On a phone or tablet it has a Paste button,
// since the system's own paste menu does not reach Haven's fields there.
component Field inherits HorizontalLayout {
    in-out property <string> text <=> edit.text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <InputType> input-type: InputType.text;
    callback accepted(string);
    callback edited(string);
    spacing: 6px;
    // The label goes to the field inside, for screen readers.
    accessible-role: none;
    edit := LineEdit {
        horizontal-stretch: 1;
        placeholder-text: root.placeholder-text;
        enabled: root.enabled;
        input-type: root.input-type;
        accessible-label: root.accessible-label;
        accepted(text) => { root.accepted(text); }
        edited(text) => { root.edited(text); }
    }
    if Device.touch && root.enabled: IconButton {
        y: (parent.height - self.height) / 2;
        icon: "paste";
        label: "Paste";
        size: 34px;
        clicked => {
            edit.paste();
            root.edited(edit.text);
        }
    }
}

component PageTitle inherits Text {
    font-family: Theme.heading-font;
    color: Theme.text;
    font-size: 26px;
    font-weight: 700;
}

component PosterCard inherits Rectangle {
    in property <Poster> poster;
    // What a right-click offers to do with the card; empty for nothing.
    in property <string> remove-label;
    callback clicked();
    callback remove();

    width: 150px;
    height: 270px;
    accessible-role: button;
    accessible-label: poster.year == "" ? poster.title : poster.title + ", " + poster.year;
    accessible-action-default => { root.clicked(); }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.remove-label != "": ContextMenuArea {
        Menu {
            MenuItem {
                title: root.remove-label;
                activated => { root.remove(); }
            }
        }
    }
    Rectangle {
        y: 0;
        height: 225px;
        border-radius: 8px;
        clip: true;
        background: Theme.surface;
        border-width: touch.has-hover || focus.has-focus ? 2px : 1px;
        border-color: touch.has-hover || focus.has-focus ? Theme.accent : Theme.border;

        if root.poster.has-image: Image {
            width: 100%;
            height: 100%;
            source: root.poster.image;
            image-fit: cover;
        }
        if !root.poster.has-image: Text {
            x: 10px;
            width: parent.width - 20px;
            height: 100%;
            text: root.poster.title;
            color: Theme.text-dim;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.poster.watched: WatchedTick {
            x: parent.width - self.width - 7px;
            y: 7px;
            size: 26px;
        }
        if root.poster.progress > 0 && !root.poster.watched: Rectangle {
            x: 8px;
            y: parent.height - 12px;
            width: parent.width - 16px;
            height: 4px;
            border-radius: 2px;
            background: #000000a0;
            Rectangle {
                x: 0;
                width: parent.width * root.poster.progress;
                border-radius: 2px;
                background: Theme.accent;
            }
        }
    }
    Text {
        y: 232px;
        width: 100%;
        text: root.poster.title;
        color: Theme.text;
        font-size: 13px;
        overflow: elide;
    }
    Text {
        y: 251px;
        width: 100%;
        text: root.poster.year;
        color: Theme.text-dim;
        font-size: 12px;
    }
}

component ShelfRow inherits VerticalLayout {
    in property <Shelf> shelf;
    // What a right-click offers to do with a card; empty for nothing.
    in property <string> remove-label;
    // Take up no room once it turns out to hold nothing.
    in property <bool> hide-empty;
    // Room under the row (when shown): rows in a list with no spacing of
    // its own, so a hidden row leaves no gap behind.
    in property <length> gap;
    callback open(Poster);
    callback remove(Poster);
    private property <length> step: 162px;
    private property <bool> hidden: root.hide-empty && !root.shelf.loading && root.shelf.error == "" && root.shelf.items.length == 0;

    spacing: 10px;
    visible: !root.hidden;
    max-height: root.hidden ? 0px : 100000px;
    padding-bottom: root.hidden ? 0px : root.gap;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Text {
            text: root.shelf.title;
            font-family: Theme.heading-font;
            color: Theme.text;
            font-size: 18px;
            font-weight: 600;
        }
        Text {
            text: root.shelf.source;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    if root.shelf.loading: Text {
        height: 40px;
        text: "Loading…";
        color: Theme.text-dim;
    }
    if !root.shelf.loading && root.shelf.error != "": Text {
        text: root.shelf.error;
        color: Theme.text-dim;
        wrap: word-wrap;
    }
    if !root.shelf.loading && root.shelf.error == "" && root.shelf.items.length == 0: Text {
        text: "Nothing here.";
        color: Theme.text-dim;
    }
    if root.shelf.items.length > 0: Rectangle {
        height: 270px;
        Flickable {
            width: parent.width;
            height: parent.height;
            content-width: root.shelf.items.length * root.step;
            content-height: self.height;
            for poster[index] in root.shelf.items: PosterCard {
                x: index * root.step;
                poster: poster;
                remove-label: root.remove-label;
                clicked => { root.open(poster); }
                remove => { root.remove(poster); }
            }
        }
    }
}

component SectionTitle inherits Text {
    font-family: Theme.heading-font;
    color: Theme.text;
    font-size: 18px;
    font-weight: 600;
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 30px;
    border-radius: 15px;
    background: selected ? Theme.accent : touch.has-hover ? Theme.hover : Theme.surface;
    border-width: 1px;
    border-color: selected ? Theme.accent : Theme.border;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    min-width: chip-label.preferred-width + 28px;
    chip-label := Text {
        text: root.label;
        color: root.selected ? (Theme.dark ? #171a22 : #ffffff) : Theme.text;
        font-size: 13px;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component EpisodeItem inherits Rectangle {
    in property <EpisodeRow> episode;
    callback clicked();
    // The round mark at the end: watched or not.
    callback toggle-watched();

    height: 44px;
    border-radius: 8px;
    background: episode.selected ? Theme.selected : touch.has-hover ? Theme.hover : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: button;
    accessible-label: episode.number + " " + episode.title;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        Text {
            width: 44px;
            text: root.episode.number;
            color: Theme.accent;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.episode.title;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.episode.date;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        // Tap to mark watched (gold tick) or unwatched (empty ring).
        Rectangle {
            width: 30px;
            mark-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle-watched(); }
            }
            if root.episode.watched: WatchedTick {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: 24px;
            }
            if !root.episode.watched: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                border-width: 1.5px;
                border-color: mark-touch.has-hover ? Theme.accent : Theme.text-dim.with-alpha(0.5);
                accessible-role: button;
                accessible-label: "Mark watched";
                accessible-action-default => { root.toggle-watched(); }
            }
        }
    }
}

// A place to watch, as a card in the title page's panel.
component SourceCard inherits Rectangle {
    in property <StreamRow> stream;
    callback play();
    callback download();

    // At least 88 px; taller when the name runs onto more lines.
    height: max(88px, card-row.preferred-height + 22px);
    border-radius: 12px;
    background: stream.playable && (touch.has-hover || focus.has-focus) ? Theme.hover : Theme.background.with-alpha(0.55);
    border-width: 1px;
    border-color: stream.playable && (touch.has-hover || focus.has-focus) ? Theme.accent : Theme.border;
    clip: true;
    accessible-role: button;
    accessible-label: (stream.playable ? "Play " : "") + stream.name + ", " + stream.kind + ", from " + stream.source;
    accessible-action-default => {
        if (stream.playable) {
            root.play();
        }
    }

    focus := FocusScope {
        enabled: root.stream.playable;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.play();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.stream.playable;
        mouse-cursor: pointer;
        clicked => { root.play(); }
    }

    // Room the buttons on the right take, so long text never pushes them
    // off the card.
    private property <length> buttons-width: (root.stream.playable && root.stream.kind == "Direct" ? 50px : 0px) + (root.stream.playable ? 50px : 80px);
    card-row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            width: root.width - 26px - root.buttons-width;
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                // The whole name, on as many lines as it needs.
                Text {
                    horizontal-stretch: 1;
                    text: root.stream.name;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                // The size, never cut off.
                if root.stream.size != "": VerticalLayout {
                  alignment: start;
                  Rectangle {
                    width: size-text.preferred-width + 14px;
                    height: 20px;
                    border-radius: 10px;
                    background: Theme.accent.with-alpha(0.15);
                    size-text := Text {
                        text: root.stream.size;
                        color: Theme.accent;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                  }
                }
                // How many are sharing it, with a people sign.
                if root.stream.seeders != "": VerticalLayout {
                  alignment: start;
                  Rectangle {
                    width: seed-row.preferred-width + 14px;
                    height: 20px;
                    border-radius: 10px;
                    background: Theme.text-dim.with-alpha(0.15);
                    accessible-role: text;
                    accessible-label: root.stream.seeders + " seeders";
                    seed-row := HorizontalLayout {
                        x: 7px;
                        spacing: 3px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            name: "account";
                            size: 12px;
                            stroke: 2.2px;
                            tint: Theme.text;
                        }
                        Text {
                            text: root.stream.seeders;
                            color: Theme.text;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                  }
                }
            }
            // The rest of the details too, in full.
            if root.stream.detail != "": Text {
                text: root.stream.detail;
                color: Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.stream.detail2 != "": Text {
                text: root.stream.detail2;
                color: Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            Text {
                text: root.stream.group == root.stream.source ? root.stream.source : root.stream.group + "  ·  " + root.stream.source;
                color: Theme.text-dim;
                font-size: 11px;
                overflow: elide;
            }
        }
        if root.stream.playable && root.stream.kind == "Direct": VerticalLayout {
            alignment: center;
            IconButton {
                icon: "download";
                label: "Download " + root.stream.name;
                size: 38px;
                clicked => { root.download(); }
            }
        }
        VerticalLayout {
            alignment: center;
            if root.stream.playable: Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: touch.has-hover || focus.has-focus ? Theme.accent : Theme.selected;
                Text {
                    text: "▶\u{FE0E}";
                    color: touch.has-hover || focus.has-focus ? (Theme.dark ? #171a22 : #ffffff) : Theme.accent;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if !root.stream.playable: Text {
                text: root.stream.kind;
                color: Theme.text-dim;
                font-size: 12px;
            }
        }
    }
}

// ---- The player ---------------------------------------------------------
// Drawn over the video, so its colours do not follow the theme.

component PlayerButton inherits Rectangle {
    in property <string> label;
    in property <string> name: label;
    in property <bool> active;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    height: 36px;
    width: max(44px, caption.preferred-width + 24px);
    border-radius: 8px;
    background: touch.pressed ? #ffffff40 : touch.has-hover || focus.has-focus ? #ffffff26 : transparent;
    accessible-role: button;
    accessible-label: name;
    accessible-action-default => { root.clicked(); }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    caption := Text {
        text: root.label;
        color: root.active ? #f2c66d : white;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A round button drawn over the picture, with a shape for a face and,
// under it, a few letters ("10", "30") where that helps.
component RoundButton inherits Rectangle {
    in property <string> shape;
    in property <string> caption;
    in property <string> name;
    in property <length> size: 64px;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    width: self.size;
    height: self.size;
    border-radius: self.size / 2;
    background: touch.pressed ? #000000c0 : touch.has-hover ? #000000a0 : #00000070;
    border-width: 1.5px;
    border-color: touch.has-hover ? #f2c66d : #ffffff50;
    accessible-role: button;
    accessible-label: name;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - (root.caption == "" ? 0px : root.size * 0.08);
        width: root.size * 0.42;
        height: root.size * 0.42;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.shape;
        fill: white;
    }
    if root.caption != "": Text {
        y: parent.height * 0.66;
        width: parent.width;
        text: root.caption;
        color: white;
        font-size: root.size * 0.17;
        font-weight: 700;
        horizontal-alignment: center;
    }
}

// A bar to drag: 0 at the left, 1 at the right.
component LevelBar inherits Rectangle {
    in property <float> value;
    out property <bool> hovered: touch.has-hover || touch.pressed;
    callback changed(float);

    height: 22px;
    accessible-role: slider;
    accessible-label: "Volume";
    accessible-value: root.value;
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: #ffffff40;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.value, 0, 1);
            border-radius: 2px;
            background: white;
        }
    }
    Rectangle {
        x: root.width * clamp(root.value, 0, 1) - 6px;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: white;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.changed(clamp(self.mouse-x / self.width, 0, 1));
            }
        }
        moved => {
            if (self.pressed) {
                root.changed(clamp(self.mouse-x / self.width, 0, 1));
            }
        }
    }
}

component SeekBar inherits Rectangle {
    in property <float> duration;
    in property <float> position;
    // How far the stream has arrived, in seconds from the start.
    in property <float> buffered;
    out property <bool> hovered: touch.has-hover || touch.pressed;
    callback seek(float);
    private property <float> dragged;
    private property <float> shown: touch.pressed ? dragged : position;
    private property <float> share: duration > 0 ? clamp(shown / duration, 0, 1) : 0;
    // The time under the pointer.
    private property <float> pointed: clamp(touch.mouse-x / self.width, 0, 1) * root.duration;

    pure function clock(seconds: float) -> string {
        return (seconds >= 3600 ? floor(seconds / 3600) + ":" + (floor(mod(seconds, 3600) / 60) < 10 ? "0" : "") : "") + floor(mod(seconds, 3600) / 60) + ":" + (floor(mod(seconds, 60)) < 10 ? "0" : "") + floor(mod(seconds, 60));
    }

    height: 22px;
    accessible-role: slider;
    accessible-label: "Position";
    accessible-value: root.position;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.duration;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.hovered ? 6px : 4px;
        border-radius: self.height / 2;
        background: #ffffff40;
        Rectangle {
            x: 0;
            width: parent.width * (root.duration > 0 ? clamp(root.buffered / root.duration, 0, 1) : 0);
            border-radius: parent.border-radius;
            background: #ffffff70;
        }
        Rectangle {
            x: 0;
            width: parent.width * root.share;
            border-radius: parent.border-radius;
            background: #f2c66d;
        }
    }
    Rectangle {
        visible: root.hovered && root.duration > 0;
        x: root.width * root.share - 7px;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: white;
    }
    // The time the pointer is over, above the bar.
    if root.hovered && root.duration > 0: Rectangle {
        x: clamp(touch.mouse-x - self.width / 2, 0px, root.width - self.width);
        y: -30px;
        width: bubble.preferred-width + 16px;
        height: 24px;
        border-radius: 6px;
        background: #151821f0;
        bubble := Text {
            text: root.clock(root.pointed);
            color: white;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.duration > 0;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.dragged = clamp(self.mouse-x / self.width, 0, 1) * root.duration;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.seek(root.dragged);
            }
        }
        moved => {
            if (self.pressed) {
                root.dragged = clamp(self.mouse-x / self.width, 0, 1) * root.duration;
            }
        }
    }
}

component TrackItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 34px;
    border-radius: 6px;
    background: touch.has-hover ? #ffffff26 : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        x: 12px;
        width: 16px;
        text: root.selected ? "✓" : "";
        color: #f2c66d;
        vertical-alignment: center;
    }
    Text {
        x: 34px;
        width: parent.width - 46px;
        text: root.label;
        color: root.selected ? #f2c66d : white;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A value with a button either side to step it down or up.
component StepRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback step(int);

    height: 38px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: #ffffffb0;
            font-size: 13px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            PlayerButton {
                width: 36px;
                height: 30px;
                label: "−";
                name: root.label + ": less";
                clicked => { root.step(-1); }
            }
        }
        Text {
            width: 64px;
            text: root.value;
            color: white;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            PlayerButton {
                width: 36px;
                height: 30px;
                label: "+";
                name: root.label + ": more";
                clicked => { root.step(1); }
            }
        }
    }
}

component PlayerView inherits Rectangle {
    in property <image> frame;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> paused;
    // Opening the stream, or waiting for more of it.
    in property <bool> busy;
    in property <string> error;
    in property <float> duration;
    in property <float> position;
    // Time watched, time left, and when it will end by the clock.
    in property <string> elapsed-text;
    in property <string> remaining-text;
    in property <string> ends-at;
    // "4.2 MB/s · 38 s ahead", and how far the stream has arrived.
    in property <string> net;
    in property <float> buffered;
    in property <[TrackRow]> audio-tracks;
    in property <[TrackRow]> subtitle-tracks;
    in property <bool> fullscreen;
    // 0 silent to 1 as recorded.
    in property <float> volume;
    in property <bool> muted;
    in property <float> speed;
    // 0 the whole picture, 1 fill (edges cut), 2 stretch.
    in property <int> fit;
    in property <float> subtitle-scale;
    in property <float> subtitle-delay;
    // What is known of the picture and sound, a fact a line.
    in property <string> info;
    // The episode after this one, in words; empty if there is none.
    in property <string> next-title;
    // Seconds until the next episode starts by itself; below 0, no countdown.
    in property <int> next-countdown;
    callback close();
    callback toggle-pause();
    callback seek(float);
    callback skip(float);
    callback choose-audio(int);
    // 0 turns subtitles off.
    callback choose-subtitle(int);
    callback toggle-fullscreen();
    callback set-volume(float);
    callback toggle-mute();
    callback set-speed(float);
    callback set-fit(int);
    // -1 or 1: a step smaller or larger, earlier or later.
    callback subtitle-scale-step(int);
    callback subtitle-delay-step(int);
    // 1: the next line shows now; -1: the line before; 0: no delay.
    callback subtitle-sync(int);
    callback next();
    callback cancel-next();
    // The bars came up or went away (subtitles move out of their way).
    callback controls-shown(bool);

    // Which list is open: 0 none, 1 audio, 2 subtitles, 3 speed,
    // 4 picture, 5 info.
    in-out property <int> menu: 0;
    private property <bool> controls: true;
    private property <bool> on-controls: top-touch.has-hover || bottom-touch.has-hover || back.hovered || bar.hovered || mute.hovered || level.hovered || audio.hovered || subs.hovered || pace.hovered || shape.hovered || about.hovered || following.hovered || full.hovered || rewind.hovered || play.hovered || forward.hovered;
    private property <bool> pinned: root.paused || root.busy || root.menu != 0 || root.error != "" || root.on-controls || root.next-countdown >= 0;
    // Set by the app: a subtitle track is showing.
    in property <bool> any-subtitle;
    private property <[float]> speeds: [0.5, 0.75, 1, 1.25, 1.5, 1.75, 2];
    private property <[string]> fits: ["Whole picture", "Fill the window (edges cut off)", "Stretch to the window"];

    private property <bool> bars: root.controls || root.pinned;
    changed bars => { root.controls-shown(root.bars); }

    background: black;
    init => {
        keys.focus();
        root.controls-shown(true);
    }

    Image {
        width: 100%;
        height: 100%;
        source: root.frame;
        image-fit: fill;
    }

    hide := Timer {
        interval: 3s;
        running: root.controls && !root.pinned;
        triggered => { root.controls = false; }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle-pause();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.skip(-10);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.skip(30);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.set-volume(clamp(root.volume + 0.05, 0, 1));
                root.controls = true;
                hide.restart();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.set-volume(clamp(root.volume - 0.05, 0, 1));
                root.controls = true;
                hide.restart();
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                root.toggle-mute();
                return accept;
            }
            if (event.text == "n" || event.text == "N") {
                if (root.next-title != "") {
                    root.next();
                }
                return accept;
            }
            if (event.text == "s" || event.text == "S") {
                root.menu = root.menu == 2 ? 0 : 2;
                return accept;
            }
            if (event.text == "f" || event.text == "F") {
                root.toggle-fullscreen();
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.menu != 0) {
                    root.menu = 0;
                } else if (root.fullscreen) {
                    root.toggle-fullscreen();
                } else {
                    root.close();
                }
                return accept;
            }
            return reject;
        }
    }

    // The picture itself: move to show the controls, click to pause.
    TouchArea {
        mouse-cursor: root.controls ? MouseCursor.default : MouseCursor.none;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                root.controls = true;
                hide.restart();
            }
        }
        clicked => {
            keys.focus();
            if (root.menu != 0) {
                root.menu = 0;
            } else if (root.error == "") {
                root.toggle-pause();
            }
        }
        double-clicked => { root.toggle-fullscreen(); }
    }

    if root.busy && root.error == "": Text {
        y: parent.height / 2 + 70px;
        height: 30px;
        text: "Loading…";
        color: white;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.error != "": Rectangle {
        width: min(parent.width - 64px, 560px);
        height: message.preferred-height + 48px;
        border-radius: 12px;
        background: #151821f0;
        message := Text {
            x: 24px;
            width: parent.width - 48px;
            text: root.error;
            color: white;
            font-size: 15px;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Top: back, what is playing, and when it ends.
    Rectangle {
        visible: root.bars;
        y: 0;
        height: 84px;
        background: @linear-gradient(180deg, #000000c0 0%, #00000000 100%);
        top-touch := TouchArea { }
        HorizontalLayout {
            padding: 16px;
            spacing: 14px;
            VerticalLayout {
                height: 40px;
                alignment: center;
                back := PlayerButton {
                    label: "‹ Back";
                    name: "Back";
                    clicked => { root.close(); }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                height: 40px;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.title;
                    color: white;
                    font-size: 17px;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.subtitle != "": Text {
                    text: root.subtitle;
                    color: #ffffffb0;
                    font-size: 13px;
                    overflow: elide;
                }
            }
            // How the stream is coming in: a globe, its speed and how far
            // ahead of the picture it has arrived.
            if root.net != "": HorizontalLayout {
                horizontal-stretch: 0;
                height: 40px;
                spacing: 7px;
                VerticalLayout {
                    alignment: center;
                    Path {
                        width: 18px;
                        height: 18px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M 2 12 A 10 10 0 1 0 22 12 A 10 10 0 1 0 2 12 Z M 12 2 A 4.5 10 0 1 0 12 22 A 4.5 10 0 1 0 12 2 Z M 2 12 L 22 12 M 4.5 6.5 L 19.5 6.5 M 4.5 17.5 L 19.5 17.5";
                        stroke: #f2c66d;
                        stroke-width: 1.8px;
                        fill: transparent;
                    }
                }
                Text {
                    text: root.net;
                    color: white;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    accessible-label: "The stream: " + root.net;
                }
                Rectangle { width: 14px; }
            }
            Text {
                height: 40px;
                text: root.ends-at;
                color: #ffffffb0;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }

    // Middle: back 10 seconds, play or pause, forward 30 seconds.
    rewind := RoundButton {
        visible: root.bars && root.error == "" && root.duration > 0;
        x: parent.width / 2 - 48px - 40px - self.width;
        y: (parent.height - self.height) / 2;
        shape: "M 12 5 L 3 12 L 12 19 Z M 21 5 L 12 12 L 21 19 Z";
        caption: "10";
        name: "Back 10 seconds";
        clicked => { root.skip(-10); }
    }
    play := RoundButton {
        visible: root.bars && root.error == "";
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 96px;
        shape: root.paused ? "M 7 4 L 20 12 L 7 20 Z" : "M 6 4 H 10 V 20 H 6 Z M 14 4 H 18 V 20 H 14 Z";
        name: root.paused ? "Play" : "Pause";
        clicked => { root.toggle-pause(); }
    }
    forward := RoundButton {
        visible: root.bars && root.error == "" && root.duration > 0;
        x: parent.width / 2 + 48px + 40px;
        y: (parent.height - self.height) / 2;
        shape: "M 3 5 L 12 12 L 3 19 Z M 12 5 L 21 12 L 12 19 Z";
        caption: "30";
        name: "Forward 30 seconds";
        clicked => { root.skip(30); }
    }

    // Bottom: position and the buttons.
    Rectangle {
        visible: root.bars && root.error == "";
        y: parent.height - self.height;
        height: 112px;
        background: @linear-gradient(180deg, #00000000 0%, #000000d8 100%);
        bottom-touch := TouchArea { }
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 12px;
            spacing: 6px;
            alignment: end;

            HorizontalLayout {
                spacing: 12px;
                Text {
                    min-width: 52px;
                    text: root.elapsed-text;
                    color: white;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                bar := SeekBar {
                    horizontal-stretch: 1;
                    duration: root.duration;
                    position: root.position;
                    buffered: root.buffered;
                    seek(seconds) => { root.seek(seconds); }
                }
                Text {
                    min-width: 52px;
                    text: root.remaining-text;
                    color: #ffffffb0;
                    font-size: 13px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 4px;
                mute := PlayerButton {
                    label: root.muted || root.volume <= 0 ? "Muted" : "Volume";
                    name: root.muted ? "Turn the sound on" : "Mute";
                    active: root.muted || root.volume <= 0;
                    clicked => { root.toggle-mute(); }
                }
                VerticalLayout {
                    alignment: center;
                    level := LevelBar {
                        width: 110px;
                        value: root.muted ? 0 : root.volume;
                        changed(value) => { root.set-volume(value); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                audio := PlayerButton {
                    visible: root.audio-tracks.length > 1;
                    label: "Audio";
                    active: root.menu == 1;
                    clicked => { root.menu = root.menu == 1 ? 0 : 1; }
                }
                subs := PlayerButton {
                    label: "Subtitles";
                    active: root.menu == 2;
                    clicked => { root.menu = root.menu == 2 ? 0 : 2; }
                }
                pace := PlayerButton {
                    label: root.speed == 1 ? "Speed" : root.speed + "×";
                    name: "Speed";
                    active: root.menu == 3 || root.speed != 1;
                    clicked => { root.menu = root.menu == 3 ? 0 : 3; }
                }
                shape := PlayerButton {
                    label: "Picture";
                    active: root.menu == 4 || root.fit != 0;
                    clicked => { root.menu = root.menu == 4 ? 0 : 4; }
                }
                about := PlayerButton {
                    label: "Info";
                    active: root.menu == 5;
                    clicked => { root.menu = root.menu == 5 ? 0 : 5; }
                }
                following := PlayerButton {
                    visible: root.next-title != "";
                    label: "Next ›";
                    name: "Next episode: " + root.next-title;
                    clicked => { root.next(); }
                }
                full := PlayerButton {
                    label: root.fullscreen ? "Exit full screen" : "Full screen";
                    clicked => { root.toggle-fullscreen(); }
                }
            }
        }
    }

    // The open list, above the buttons that open it.
    if root.menu != 0: Rectangle {
        x: parent.width - self.width - 20px;
        y: parent.height - 112px - self.height + 30px;
        width: 340px;
        height: min(list.preferred-height + 50px, parent.height - 200px);
        border-radius: 10px;
        background: #151821f4;
        border-width: 1px;
        border-color: #ffffff26;
        clip: true;
        TouchArea { }
        Text {
            x: 14px;
            y: 10px;
            text: root.menu == 1 ? "Audio" : root.menu == 2 ? "Subtitles" : root.menu == 3 ? "Speed" : root.menu == 4 ? "Picture" : "About what is playing";
            color: #ffffffb0;
            font-size: 12px;
            font-weight: 600;
        }
        Flickable {
            x: 6px;
            y: 36px;
            width: parent.width - 12px;
            height: parent.height - 44px;
            content-height: list.preferred-height;
            list := VerticalLayout {
                alignment: start;
                if root.menu == 2: TrackItem {
                    label: "Off";
                    selected: !root.any-subtitle;
                    clicked => {
                        root.choose-subtitle(0);
                        root.menu = 0;
                    }
                }
                if root.menu == 1 || root.menu == 2: VerticalLayout {
                    for track in root.menu == 1 ? root.audio-tracks : root.subtitle-tracks: TrackItem {
                        label: track.label;
                        selected: track.selected;
                        clicked => {
                            if (root.menu == 1) {
                                root.choose-audio(track.id);
                            } else {
                                root.choose-subtitle(track.id);
                            }
                            root.menu = 0;
                        }
                    }
                }
                if root.menu == 2 && root.subtitle-tracks.length == 0: Text {
                    height: 34px;
                    x: 12px;
                    text: "This has no subtitles of its own.";
                    color: #ffffffb0;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                if root.menu == 2: StepRow {
                    label: "Size";
                    value: round(root.subtitle-scale * 100) + " %";
                    step(way) => { root.subtitle-scale-step(way); }
                }
                if root.menu == 2: StepRow {
                    label: "Shown later by";
                    value: (round(root.subtitle-delay * 10) / 10) + " s";
                    step(way) => { root.subtitle-delay-step(way); }
                }
                // Out of step with the sound? When someone starts to speak,
                // press the one that fits: the subtitles move to match.
                if root.menu == 2 && root.subtitle-tracks.length > 0: Rectangle {
                    height: 26px;
                    Text {
                        x: 12px;
                        text: "Out of step? As someone starts to speak:";
                        color: #ffffffb0;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                if root.menu == 2 && root.subtitle-tracks.length > 0: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    height: 36px;
                    PlayerButton {
                        label: "Show next line now";
                        clicked => { root.subtitle-sync(1); }
                    }
                    PlayerButton {
                        label: "Line before";
                        clicked => { root.subtitle-sync(-1); }
                    }
                    PlayerButton {
                        label: "Reset";
                        clicked => { root.subtitle-sync(0); }
                    }
                }
                if root.menu == 3: VerticalLayout {
                    for speed in root.speeds: TrackItem {
                        label: speed == 1 ? "Normal" : speed + "×";
                        selected: root.speed == speed;
                        clicked => {
                            root.set-speed(speed);
                            root.menu = 0;
                        }
                    }
                }
                if root.menu == 4: VerticalLayout {
                    for name[index] in root.fits: TrackItem {
                        label: name;
                        selected: root.fit == index;
                        clicked => {
                            root.set-fit(index);
                            root.menu = 0;
                        }
                    }
                }
                if root.menu == 5: Rectangle {
                    height: facts.preferred-height + 16px;
                    facts := Text {
                        x: 12px;
                        y: 4px;
                        width: parent.width - 24px;
                        text: root.info == "" ? "Nothing is known yet." : root.info;
                        color: white;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // The next episode is about to start by itself.
    if root.next-countdown >= 0: Rectangle {
        x: parent.width - self.width - 20px;
        y: parent.height - 112px - self.height - 8px;
        width: 380px;
        height: 104px;
        border-radius: 12px;
        background: #151821f4;
        border-width: 1px;
        border-color: #ffffff26;
        TouchArea { }
        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            Text {
                text: root.next-countdown > 0 ? "Next episode in " + root.next-countdown + " s" : "Starting the next episode…";
                color: #ffffffb0;
                font-size: 12px;
                font-weight: 600;
            }
            Text {
                text: root.next-title;
                color: white;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                PlayerButton {
                    label: "Cancel";
                    clicked => { root.cancel-next(); }
                }
                PlayerButton {
                    label: "Play now";
                    active: true;
                    clicked => { root.next(); }
                }
            }
        }
    }
}

component AddonCard inherits Rectangle {
    in property <AddonRow> addon;
    callback remove();
    callback switched(bool);

    height: 84px;
    border-radius: 10px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: (root.addon.version == "" ? root.addon.name : root.addon.name + "  " + root.addon.version) + (root.addon.enabled ? "" : "  ·  switched off");
                color: root.addon.enabled ? Theme.text : Theme.text-dim;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.addon.description;
                color: Theme.text-dim;
                font-size: 12px;
                overflow: elide;
            }
            Text {
                text: (root.addon.catalogs == 1 ? "1 catalogue" : root.addon.catalogs + " catalogues") + "  ·  " + root.addon.url;
                color: Theme.text-dim;
                font-size: 12px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Switch {
                checked: root.addon.enabled;
                accessible-label: "Use " + root.addon.name;
                toggled => { root.switched(self.checked); }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "Remove";
                accessible-label: "Remove " + root.addon.name;
                clicked => { root.remove(); }
            }
        }
    }
}

// One line of a list down the side of a page: a category, a source.
component SideItem inherits Rectangle {
    in property <string> label;
    // Shown dimmed at the end, such as a count.
    in property <string> trailing;
    in property <bool> selected;
    in property <bool> star;
    // Shows a small cross that asks to remove it.
    in property <bool> removable;
    callback clicked();
    callback remove();

    height: 34px;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        y: 1px;
        height: parent.height - 2px;
        border-radius: 8px;
        background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        if root.star: Text {
            text: "★";
            color: Theme.accent;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.selected ? Theme.text : Theme.text-dim;
            font-weight: root.selected ? 600 : 400;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.trailing;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        if root.removable: Rectangle {
            width: 20px;
            accessible-role: button;
            accessible-label: "Delete " + root.label;
            accessible-action-default => { root.remove(); }
            cross := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.remove(); }
            }
            Text {
                text: "×";
                color: cross.has-hover ? Theme.text : Theme.text-dim;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component ChannelItem inherits Rectangle {
    in property <ChannelRow> channel;
    in property <bool> can-play;
    callback clicked();
    // Asks to choose the channel's Favourites groups.
    callback star();

    height: 46px;
    accessible-role: button;
    accessible-label: channel.name;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        y: 2px;
        height: parent.height - 4px;
        border-radius: 8px;
        background: touch.has-hover ? Theme.hover : Theme.surface;
        border-width: 1px;
        border-color: touch.has-hover && root.can-play ? Theme.accent : Theme.border;
    }
    touch := TouchArea {
        mouse-cursor: root.can-play ? pointer : default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 12px;
        Text {
            horizontal-stretch: 1;
            text: root.channel.name;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.channel.group;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        if root.can-play: Text {
            text: "▶\u{FE0E}";
            color: Theme.accent;
            font-size: 12px;
            vertical-alignment: center;
        }
        Rectangle {
            width: 32px;
            accessible-role: button;
            accessible-label: (root.channel.starred ? "Change the Favourites groups of " : "Add to Favourites: ") + root.channel.name;
            accessible-action-default => { root.star(); }
            star-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.star(); }
            }
            Text {
                text: root.channel.starred ? "★" : "☆";
                color: root.channel.starred || star-touch.has-hover ? Theme.accent : Theme.text-dim;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// Live TV and Radio share this: the categories down the left (Favourites
// groups first), and the chosen category's channels beside them.
component ChannelsPage inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in property <[ChannelRow]> channels;
    in property <[CategoryRow]> categories;
    // Channels before filtering.
    in property <int> total;
    // The chosen category's key; empty for every channel.
    in-out property <string> category;
    in-out property <string> words;
    in property <bool> can-play;
    // A phone's screen: the categories show instead of the channels
    // when asked for, not beside them.
    in property <bool> compact;
    // Which of television (0) and radio (1) shows.
    in-out property <int> band;
    callback band-chosen(int);
    private property <bool> picking;
    private property <string> new-group;
    // The words to look for, and the category's key.
    callback filter(string, string);
    callback filter-categories(string);
    callback play(int);
    callback star(int);
    callback make-group(string);
    callback delete-group(string);

    padding-left: root.compact ? 16px : 32px;
    padding-right: root.compact ? 16px : 32px;
    padding-top: root.compact ? 16px : 32px;
    padding-bottom: 16px;
    spacing: 12px;

    HorizontalLayout {
        spacing: 12px;
        PageTitle {
            text: root.title;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Segments {
            labels: ["TV", "Radio"];
            current <=> root.band;
            chosen(index) => { root.band-chosen(index); }
        }
    }
    if root.total == 0: Text {
        text: root.hint;
        color: Theme.text-dim;
        wrap: word-wrap;
    }
    @children
    if root.total > 0 && !root.can-play: Text {
        text: "The player is not available on this computer (its graphics have no usable OpenGL), so channels are listed but cannot be played.";
        color: Theme.text-dim;
        wrap: word-wrap;
    }
    if root.total > 0 && root.compact: HorizontalLayout {
        alignment: start;
        Chip {
            label: root.picking ? "‹  Back to the channels" : "Categories  ›";
            selected: root.picking;
            clicked => { root.picking = !root.picking; }
        }
    }
    if root.total > 0: HorizontalLayout {
        vertical-stretch: 1;
        spacing: root.compact ? 0px : 20px;
        VerticalLayout {
            visible: !root.compact || root.picking;
            horizontal-stretch: root.compact && root.picking ? 1 : 0;
            min-width: root.compact ? 0px : 270px;
            max-width: root.compact ? (root.picking ? 10000px : 0px) : 270px;
            spacing: 8px;
            Field {
                placeholder-text: "Find a category";
                accessible-label: "Find a category";
                edited(text) => { root.filter-categories(text); }
            }
            HorizontalLayout {
                spacing: 6px;
                Field {
                    text <=> root.new-group;
                    placeholder-text: "New Favourites group";
                    accessible-label: "Name of a new Favourites group";
                    accepted(text) => {
                        root.make-group(text);
                        root.new-group = "";
                    }
                }
                Button {
                    text: "Add";
                    enabled: root.new-group != "";
                    accessible-label: "Add the Favourites group";
                    clicked => {
                        root.make-group(root.new-group);
                        root.new-group = "";
                    }
                }
            }
            ListView {
                vertical-stretch: 1;
                for row in root.categories: SideItem {
                    label: row.label;
                    trailing: row.count;
                    selected: row.key == root.category;
                    star: row.favourite;
                    removable: row.favourite;
                    clicked => {
                        root.category = row.key;
                        root.filter(root.words, row.key);
                        root.picking = false;
                    }
                    remove => { root.delete-group(row.label); }
                }
            }
        }
        VerticalLayout {
            visible: !(root.compact && root.picking);
            horizontal-stretch: root.compact && root.picking ? 0 : 1;
            max-width: root.compact && root.picking ? 0px : 10000px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 12px;
                Field {
                    text <=> root.words;
                    placeholder-text: "Filter by name";
                    accessible-label: "Filter by name";
                    edited(text) => { root.filter(text, root.category); }
                }
                Text {
                    text: root.channels.length == root.total ? root.total + " in all" : root.channels.length + " of " + root.total;
                    color: Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
            if root.channels.length == 0: Text {
                text: "Nothing here. Use the ☆ on a channel to put it in a Favourites group.";
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            ListView {
                vertical-stretch: 1;
                for channel in root.channels: ChannelItem {
                    channel: channel;
                    can-play: root.can-play;
                    clicked => { root.play(channel.index); }
                    star => { root.star(channel.index); }
                }
            }
        }
    }
    if root.total == 0: Rectangle { vertical-stretch: 1; }
}

component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;

    height: 56px;
    border-radius: 10px;

    HorizontalLayout {
        padding-left: 0px;
        padding-right: 0px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
            }
            Text {
                text: root.detail;
                color: Theme.text-dim;
                font-size: 12px;
                overflow: elide;
            }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            @children
        }
    }
}

export component AppWindow inherits Window {
    in-out property <int> page: 0;
    in-out property <bool> dark <=> Theme.dark;
    in property <string> version;
    in property <string> data-path;
    in property <string> log-path;
    // The services that have the open title, and what to say about them.
    in property <[OfferRow]> offers;
    in property <string> offers-note;
    in property <string> offers-link;
    // The countries to choose from for those services, and the chosen one.
    in property <[string]> countries;
    in-out property <int> country-index;
    // A store build (App Store, Google Play): no Add-ons page, no mention of add-ons.
    in property <bool> addons-hidden;
    in property <[SharedAddonRow]> shared-addons;
    // How many pictures are kept on this computer, in words.
    in property <string> cache-status;
    in property <[string]> pages: ["Home", "Explore", "Library", "Live TV", "Calendar", "Settings"];

    in property <[Shelf]> shelves;
    in property <[AddonRow]> addons;
    in property <bool> addon-busy;
    in property <string> addon-status;
    in property <bool> addon-status-is-error;
    in-out property <string> addon-address;
    in property <[Shelf]> search-shelves;
    in property <string> search-note;
    in-out property <string> search-query;
    in property <bool> detail-open;
    in property <Detail> detail;
    in property <[int]> seasons;
    in property <int> season;
    in property <[EpisodeRow]> episodes;
    in property <string> streams-title: "Streams";
    in property <bool> streams-loading;
    in property <string> streams-note;
    in property <[StreamRow]> streams;
    // The providers of those, to narrow the list to one; and the chosen
    // one ("" for all).
    in property <[StreamGroup]> stream-groups;
    in-out property <string> stream-group;
    // An episode is picked: the panel lists its places to watch.
    in-out property <bool> episode-open;
    // The picked episode in words, such as "S3 E4 · Its name".
    in property <string> episode-label;
    in-out property <string> episode-filter;
    // Where the open film or episode would resume, in words; often empty.
    in property <string> resume-note;
    // Titles saved to watch later, newest first.
    in property <[Poster]> watchlist;
    // Titles to carry on with, shown first on Home when there are any.
    in property <Shelf> continue-shelf;

    // Chromecasts found on the network, by name.
    in property <[string]> cast-devices;
    // Where a stream plays: -1 this computer, else an index into cast-devices.
    in-out property <int> cast-target: -1;
    in property <bool> cast-finding;
    in property <string> cast-note;
    // A stream is playing on a Chromecast.
    in property <bool> casting;
    in property <string> cast-title;
    in property <string> cast-device-name;
    in property <string> cast-time;
    in property <bool> cast-paused;
    in property <string> cast-status;

    in-out property <string> keys-tmdb;
    // This copy of Haven has its own TMDB key, so one of yours is optional.
    in property <bool> tmdb-built-in;
    in-out property <string> keys-trakt-id;
    in-out property <string> keys-trakt-secret;
    in-out property <string> keys-simkl-id;
    in property <string> keys-status;
    in property <[TrackingRow]> tracking;
    in property <bool> tracking-busy;
    in property <string> tracking-status;
    // While a sign-in waits for approval: the code and the page.
    in property <string> tracking-code;
    in property <string> tracking-link;

    in property <[ServerRow]> servers;
    // One "New in" and one A to Z shelf per library of each media server.
    in property <[Shelf]> server-shelves;
    // Shelves from the built-in TMDB catalogue; empty without a TMDB key.
    in property <[Shelf]> catalog-shelves;

    // Explore: where to browse (the TMDB catalogue, each media server
    // library, each add-on catalogue), then what kind and which genre.
    in property <[ExploreRow]> explore-sources;
    // How many sources there are, whatever the filter shows.
    in property <int> explore-count;
    in-out property <int> explore-source;
    // "Films" and "Series" where the source has both; else empty.
    in property <[string]> explore-kinds;
    in-out property <int> explore-kind;
    in property <[string]> explore-genres;
    // -1 for every genre.
    in-out property <int> explore-genre: -1;
    in property <[Poster]> explore-items;
    in property <bool> explore-loading;
    in property <string> explore-note;
    // There is another page to fetch.
    in property <bool> explore-more;
    // Which kind the sign-in form is for: 0 Jellyfin, 1 Emby, 2 Plex.
    in-out property <int> server-kind;
    in-out property <string> server-address;
    in-out property <string> server-user;
    in-out property <string> server-password;
    in property <bool> server-busy;
    in property <string> server-status;
    in property <bool> server-status-is-error;
    // While a Plex sign-in waits for approval: the code and the page.
    in property <string> plex-code;
    in property <string> plex-link;

    in property <[SourceRow]> tv-sources;
    in-out property <string> xtream-server;
    in-out property <string> xtream-user;
    in-out property <string> xtream-password;
    in property <bool> xtream-busy;
    in property <string> xtream-status;
    in property <bool> xtream-status-is-error;
    in-out property <string> tv-address;
    in property <bool> tv-busy;
    in property <string> tv-status;
    in property <bool> tv-status-is-error;
    in property <[ChannelRow]> tv-channels;
    in property <[CategoryRow]> tv-categories;
    in property <int> tv-total;
    in-out property <string> tv-category;
    in-out property <string> tv-words;
    in property <[ChannelRow]> radio-channels;
    in property <[CategoryRow]> radio-categories;
    in property <int> radio-total;
    in-out property <string> radio-category;
    // The chooser of Favourites groups for one channel.
    in property <bool> fav-open;
    in property <string> fav-channel;
    in property <[FavPick]> fav-picks;
    in-out property <string> fav-new-name;
    in-out property <string> radio-words;
    // False in a build without the player.
    in property <bool> can-play-channels;

    in property <bool> player-open;
    in property <image> player-frame;
    in property <string> player-title;
    in property <string> player-subtitle;
    in property <bool> player-paused;
    in property <bool> player-busy;
    in property <string> player-error;
    in property <float> player-duration;
    in property <float> player-position;
    in property <string> player-time;
    in property <string> player-elapsed;
    in property <string> player-remaining;
    in property <string> player-ends-at;
    in property <string> player-net;
    in property <float> player-buffered;
    in property <float> player-volume: 1;
    in property <bool> player-muted;
    in property <float> player-speed: 1;
    in property <int> player-fit;
    in property <float> player-subtitle-scale: 1;
    in property <float> player-subtitle-delay;
    in property <string> player-info;
    // Dolby and DTS sound goes to the sound device untouched.
    in property <bool> player-passthrough;
    in property <string> player-next-title;
    in property <int> player-next-countdown: -1;
    in property <[TrackRow]> player-audio;
    in property <[TrackRow]> player-subtitles;
    in property <bool> player-any-subtitle;
    in property <bool> player-fullscreen;
    // Which of the player's lists is open: 0 none, 1 audio, 2 subtitles.
    in-out property <int> player-menu;
    private property <int> home-page: 0;
    private property <int> explore-page: 1;
    private property <int> library-page: 2;
    private property <int> tv-page: 3;
    private property <int> calendar-page: 4;
    private property <int> settings-page: 5;
    // The Library's part showing: 0 Downloads, 1 Watchlist, 2 History.
    in-out property <int> library-tab;
    // Live TV shows television (0) or radio (1).
    in-out property <int> live-band;
    // The part of Settings showing: 0 General, 1 Accounts, 2 Media
    // servers, 3 Add-ons, 4 Live TV, 5 Downloads and storage, 6 About.
    in-out property <int> settings-section;
    // A phone: Settings shows its list of parts, not one part.
    in-out property <bool> settings-picking: true;
    // The advanced keys in Settings > Accounts are open.
    in-out property <bool> keys-open;
    // Explore is showing search results.
    in-out property <bool> explore-searching;
    in property <[DownloadRow]> download-rows;
    in property <int> downloads-count;
    in property <string> downloads-folder;
    // Everything watched, newest first.
    in property <[Poster]> history;
    in property <[HeroSlide]> hero;
    in-out property <int> hero-index;
    in property <[UpcomingCard]> upcoming;
    in property <[ContinueCard]> continue-cards;
    // The calendar shows a week, not a month.
    in property <bool> calendar-is-week;
    callback download-stream(int);
    callback download-remove(int);
    callback download-toggle(int);
    callback download-play(int);
    callback open-downloads-folder();
    callback calendar-week(bool);
    // Settings > Sync options.
    in property <string> sync-status;
    in property <[SyncAccount]> sync-accounts;
    in property <string> sync-note;
    in property <bool> sync-busy;
    // An account is syncing.
    in property <bool> sync-linked;
    // Changes still to send (red with this count; 0 is green).
    in property <int> sync-waiting;
    // The last try failed.
    in property <bool> sync-problem;
    callback sync-now();
    // An account's sync switched on or off (0 Trakt, 1 Simkl).
    callback sync-account(int, bool);
    // `mobile`: a phone or tablet build. `compact`: a phone's screen,
    // where the pages are laid out for one column and the side list
    // gives way to tabs. Both are set when Haven starts.
    in property <bool> mobile;
    changed mobile => { Device.touch = root.mobile; }
    // An iPhone or iPad.
    in property <bool> ios;
    in property <bool> compact;
    // On a phone: Explore shows its list of sources, not the titles.
    in-out property <bool> explore-picking;
    // The navigation bar along the bottom.
    private property <length> nav-height: root.player-open ? 0px : (root.compact ? 78px : 92px) + root.safe-area-insets.bottom;
    // Something fills Home: a media server, an add-on or the TMDB catalogue.
    private property <bool> home-has-sources: root.addons.length > 0 || root.servers.length > 0 || root.catalog-shelves.length > 0;

    callback page-selected(int);
    callback dark-toggled(bool);
    callback install-addon(string);
    callback remove-addon(string);
    callback search(string);
    callback open-title(Poster);
    callback close-detail();
    callback season-selected(int);
    callback episode-selected(string);
    // The title page's panel (places to watch, or a season's episodes)
    // shows only once asked for, so the page opens on the poster and
    // the details alone.
    in-out property <bool> detail-panel-open;
    // A film's "Sources" button: look up where to watch it now.
    callback show-sources();
    // Marked by hand: an episode (by id), the season showing, the film.
    callback episode-watched(string, bool);
    callback season-watched(bool);
    callback film-watched(bool);
    // Every episode listed for the season showing is watched.
    in property <bool> season-all-watched;
    callback filter-episodes(string);
    // Puts the open title on the watchlist, or takes it off.
    callback toggle-watchlist();
    // Takes a title off Continue Watching (forgets how far it was watched).
    callback remove-continue(Poster);
    // Kind (0 Jellyfin, 1 Emby), address, user name, password.
    callback server-sign-in(int, string, string, string);
    callback plex-sign-in();
    callback plex-cancel();
    callback remove-server(int);
    // Switch an add-on (by address), a media server (by number) or a
    // television source (by address) on or off without removing it.
    callback set-addon-enabled(string, bool);
    callback set-server-enabled(int, bool);
    callback set-tv-source-enabled(string, bool);
    callback filter-categories(bool, string);
    // Radio or television and a channel's index: choose its Favourites groups.
    callback fav-pick(bool, int);
    callback fav-toggle(string);
    callback fav-new-group(string);
    callback fav-delete-group(string);
    callback fav-close();
    callback explore-filter(string);
    callback country-selected(int);
    // Installs a media server's add-on in Haven; -1 for all of them.
    callback install-shared(int);
    // Deletes the pictures kept on this computer.
    callback clear-cache();
    // Asks every media server again whether it answers.
    callback check-servers();
    // Explore: the source, kind and genre chosen (genre -1 for all).
    callback explore-pick(int, int, int);
    callback explore-load-more();
    // Pulled down: load the source showing afresh.
    callback explore-refresh();
    in property <bool> explore-refreshing;
    // Server address, user name, password.
    callback add-xtream(string, string, string);
    // Opens a web address in the user's browser.
    callback open-link(string);
    callback find-cast-devices();
    // "pause" (toggles), "back", "forward" or "stop".
    callback cast-command(string);
    callback save-keys();
    // 0 Trakt, 1 Simkl.
    callback tracking-connect(int);
    callback tracking-cancel();
    callback tracking-disconnect(int);
    // Copies that service's watchlist into Haven's.
    callback tracking-import(int);
    callback add-tv-source(string);
    callback remove-tv-source(string);
    // Radio or television, the words to look for, the category's key.
    callback filter-channels(bool, string, string);
    // Radio or television, and the channel's index.
    callback play-channel(bool, int);
    // The row of the stream list to play.
    callback play-stream(int);
    // What plays videos: 0 Haven's own player, 1 VLC, 2 mpv, 3 another
    // program, named in `player-program`.
    in-out property <int> player-choice;
    in-out property <string> player-program;
    // Haven's own player works on this computer.
    in property <bool> player-own-works;
    // What became of handing a video to another program, in words.
    in-out property <string> play-note;
    callback set-player-choice(int);
    callback set-player-program(string);
    // A newer Haven: its version ("" if none is known), where to get
    // it, and what the last look found, in words.
    in property <string> update-version;
    // A download or installation is under way.
    in-out property <bool> update-busy;
    in property <string> update-status;
    in-out property <bool> update-check-at-start: true;
    callback check-updates();
    // What is new in the latest release, and its version.
    in property <[NoteLine]> update-notes;
    in property <string> update-notes-version;
    // Opens GitHub's page for a new issue.
    callback report-issue();
    // How far the Settings page is scrolled (for checking it in snapshots).
    in-out property <length> settings-scroll;
    // Download the newer Haven and install it.
    callback install-update();
    callback set-update-check(bool);
    in property <string> calendar-title;
    in property <[CalendarDay]> calendar-days;
    // A phone: the square whose releases show under the month.
    in-out property <int> calendar-pick;
    // A computer: a day was clicked, so the side list shows that day only.
    in-out property <bool> calendar-day-only;
    in property <[AgendaRow]> calendar-agenda;
    in property <string> calendar-note;
    in property <string> calendar-zone;
    // The Calendar page came into view.
    callback calendar-shown();
    // A month back (-1), on (1), or this month (0).
    callback calendar-step(int);
    callback calendar-open(CalendarEntry);
    private property <bool> calendar-showing: !root.detail-open && root.page == root.calendar-page;
    changed calendar-showing => {
        if (root.calendar-showing) {
            root.calendar-shown();
        }
    }
    // Home came into view or left it: its loading goes on or waits.
    callback home-showing-changed(bool);
    // Pulled down: load Home afresh.
    callback home-refresh();
    in property <bool> home-refreshing;
    out property <bool> home-showing: !root.detail-open && !root.player-open && root.page == root.home-page;
    changed home-showing => { root.home-showing-changed(root.home-showing); }
    callback show-more-streams(string);
    callback player-close();
    callback player-toggle-pause();
    callback player-seek(float);
    callback player-skip(float);
    callback player-choose-audio(int);
    callback player-choose-subtitle(int);
    callback player-toggle-fullscreen();
    callback player-set-volume(float);
    callback player-toggle-mute();
    callback player-set-speed(float);
    callback player-set-fit(int);
    callback player-subtitle-scale-step(int);
    callback player-subtitle-delay-step(int);
    callback player-subtitle-sync(int);
    callback player-set-passthrough(bool);
    callback player-next();
    callback player-cancel-next();
    callback player-controls-shown(bool);

    title: "Haven";
    icon: @image-url("../../../assets/icon/haven-256.png");
    preferred-width: root.compact ? 412px : 1180px;
    preferred-height: root.compact ? 880px : 720px;
    min-width: root.compact ? 320px : 820px;
    min-height: root.compact ? 480px : 520px;
    background: Theme.background;
    default-font-size: 14px;
    default-font-family: "Figtree";

    init => {
        Device.touch = root.mobile;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    VerticalLayout {
        // Clear of the phone's status bar (nothing on a computer).
        padding-top: root.player-open ? 0px : root.safe-area-insets.top;
    HorizontalLayout {
        vertical-stretch: 1;
        Rectangle {
            visible: !root.player-open;
            horizontal-stretch: 1;

            if root.detail-open: detail-view := Rectangle {
                // A series lists its episodes in the panel first; a film,
                // or an episode once picked, lists its places to watch.
                private property <bool> is-series: root.episodes.length > 0 || root.seasons.length > 0;
                private property <bool> sources-shown: !self.is-series || root.episode-open;
                private property <bool> panel: root.detail-panel-open;
                private property <length> panel-width: root.compact ? self.width - 24px : clamp(self.width * 0.42, 360px, 540px);
                // A phone: details over the top part, the panel under them
                // (all of the screen until the panel is asked for).
                private property <length> top-part: root.compact && self.panel ? min(self.height * 0.4, 330px) : self.height;
                clip: true;
                background: Theme.background;

                if root.detail.has-background: Image {
                    width: 100%;
                    height: 100%;
                    source: root.detail.background;
                    image-fit: cover;
                }
                // Darkened towards the words on the left and the bottom.
                Rectangle {
                    background: @linear-gradient(90deg, Theme.background.with-alpha(0.94) 0%, Theme.background.with-alpha(0.6) 55%, Theme.background.with-alpha(0.4) 100%);
                }
                Rectangle {
                    background: @linear-gradient(180deg, transparent 35%, Theme.background.with-alpha(0.9) 100%);
                }

                // ---- The title, on the left over the picture.
                // Scrolls when the window is too short for it all; when it
                // fits, the details sit low on the picture as before.
                info-scroll := ScrollView {
                    x: root.compact ? 16px : 40px;
                    y: 0px;
                    width: root.compact ? parent.width - 32px : detail-view.panel ? parent.width - detail-view.panel-width - 24px - 40px - 36px : min(parent.width - 80px, 820px);
                    height: detail-view.top-part;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, info-col.preferred-height);
                info-col := VerticalLayout {
                    width: info-scroll.visible-width;
                    height: info-scroll.content-height;
                    padding-top: root.compact ? 10px : 20px;
                    padding-bottom: root.compact ? 10px : 36px;
                    spacing: root.compact ? 6px : 10px;

                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "‹ Back";
                            accessible-label: "Back";
                            clicked => { root.close-detail(); }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    if root.detail.has-poster && (root.compact ? !detail-view.panel && detail-view.height > 520px : detail-view.height > 560px): HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            width: root.compact ? 110px : 120px;
                            height: root.compact ? 165px : 180px;
                            border-radius: 10px;
                            clip: true;
                            border-width: 1px;
                            border-color: Theme.border;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: root.detail.poster;
                                image-fit: cover;
                            }
                        }
                    }
                    Text {
                        text: root.detail.title;
                        font-family: Theme.heading-font;
                        color: Theme.text;
                        font-size: root.compact ? 24px : 36px;
                        font-weight: 800;
                        wrap: word-wrap;
                    }
                    // A film: the pill marks it watched or unwatched.
                    if root.detail.film || root.detail.watched: HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            height: 30px;
                            border-radius: 15px;
                            background: root.detail.watched ? Theme.accent.with-alpha(0.14) : film-mark.has-hover ? Theme.hover : transparent;
                            border-width: 1.5px;
                            border-color: root.detail.watched ? Theme.accent : Theme.text-dim.with-alpha(0.6);
                            accessible-role: button;
                            accessible-label: root.detail.watched ? "Watched. Mark unwatched" : "Mark watched";
                            accessible-action-default => { root.film-watched(!root.detail.watched); }
                            film-mark := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.film-watched(!root.detail.watched); }
                            }
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 14px;
                                spacing: 7px;
                                if root.detail.watched: WatchedTick {
                                    y: (parent.height - self.height) / 2;
                                    size: 20px;
                                }
                                if !root.detail.watched: Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    border-width: 1.5px;
                                    border-color: Theme.text-dim;
                                }
                                Text {
                                    text: root.detail.watched ? "Watched" : "Mark watched";
                                    color: root.detail.watched ? Theme.accent : Theme.text;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    if root.episode-open && root.episode-label != "": Text {
                        text: root.episode-label;
                        color: Theme.accent;
                        font-size: 18px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    if root.detail.facts != "": Text {
                        text: root.detail.facts;
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    if root.detail.loading: Text {
                        text: "Loading details…";
                        color: Theme.text-dim;
                    }
                    if root.detail.error != "": Text {
                        text: root.detail.error;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    if root.detail.description != "": Text {
                        text: root.detail.description;
                        color: Theme.text;
                        font-size: 14px;
                        wrap: word-wrap;
                        overflow: elide;
                        max-height: root.compact ? (detail-view.panel ? 54px : 140px) : 118px;
                    }
                    if root.detail.cast != "" && !root.compact: Text {
                        text: "Cast   " + root.detail.cast;
                        color: Theme.text-dim;
                        font-size: 13px;
                        overflow: elide;
                    }
                    if root.detail.director != "" && !root.compact: Text {
                        text: "Director   " + root.detail.director;
                        color: Theme.text-dim;
                        font-size: 13px;
                        overflow: elide;
                    }
                    // Where to watch: the services that have it, grouped
                    // Stream / Free / Rent / Buy, on Haven's own tiles.
                    if root.offers.length > 0: VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Where to watch  ·  " + root.offers-note;
                            color: Theme.text-dim;
                            font-size: 12px;
                            overflow: elide;
                        }
                        Rectangle {
                            height: 92px;
                            Flickable {
                                width: parent.width;
                                height: parent.height;
                                content-width: offer-tiles.preferred-width;
                                content-height: self.height;
                                offer-tiles := HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    for offer[i] in root.offers: VerticalLayout {
                                        padding-left: offer.group != "" && i > 0 ? 16px : 0px;
                                        spacing: 4px;
                                        width: 60px + (offer.group != "" && i > 0 ? 16px : 0px);
                                        Text {
                                            height: 14px;
                                            text: offer.group;
                                            color: Theme.accent;
                                            font-size: 11px;
                                            font-weight: 600;
                                        }
                                        Rectangle {
                                            width: 52px;
                                            height: 52px;
                                            border-radius: 12px;
                                            background: offer.tint;
                                            border-width: tile-touch.has-hover ? 2px : 1px;
                                            border-color: tile-touch.has-hover ? Theme.accent : #ffffff14;
                                            accessible-role: button;
                                            accessible-label: offer.name + ", " + offer.ways + ". Opens JustWatch";
                                            accessible-action-default => {
                                                if (root.offers-link != "") {
                                                    root.open-link(root.offers-link);
                                                }
                                            }
                                            tile-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if (root.offers-link != "") {
                                                        root.open-link(root.offers-link);
                                                    }
                                                }
                                            }
                                            Text {
                                                text: offer.letters;
                                                color: offer.ink;
                                                font-size: offer.letters.character-count > 2 ? 13px : 17px;
                                                font-weight: 800;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            width: 56px;
                                            text: offer.name;
                                            color: Theme.text-dim;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                        Text {
                            text: "Tap a service to see it on JustWatch. Availability by JustWatch.";
                            color: Theme.text-dim;
                            font-size: 10px;
                            opacity: 0.8;
                        }
                    }
                    if root.offers.length == 0 && root.offers-note != "" && !root.detail.loading: Text {
                        text: root.offers-note;
                        color: Theme.text-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        padding-top: 6px;
                        spacing: 10px;
                        // A film: where to watch it is looked up on asking.
                        if !detail-view.is-series && !root.detail.loading: PrimaryButton {
                            text: "▶  Sources";
                            clicked => {
                                root.detail-panel-open = true;
                                root.show-sources();
                            }
                        }
                        // A series without seasons: its episodes on asking.
                        if detail-view.is-series && root.seasons.length == 0: PrimaryButton {
                            text: "Episodes";
                            clicked => { root.detail-panel-open = true; }
                        }
                        Chip {
                            height: 38px;
                            border-radius: 19px;
                            width: root.detail.saved ? 160px : 180px;
                            label: root.detail.saved ? "✓  On Watchlist" : "＋  Add to Watchlist";
                            selected: root.detail.saved;
                            clicked => { root.toggle-watchlist(); }
                        }
                    }
                    // A series: its seasons; picking one lists its episodes.
                    if root.seasons.length > 0 && !(root.compact && detail-view.panel): Rectangle {
                        height: 38px;
                        Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-width: root.seasons.length * 112px;
                            content-height: self.height;
                            for number[index] in root.seasons: Chip {
                                x: index * 112px;
                                width: 104px;
                                height: 36px;
                                label: number == 0 ? "Specials" : "Season " + number;
                                selected: detail-view.panel && number == root.season;
                                clicked => {
                                    root.episode-open = false;
                                    root.detail-panel-open = true;
                                    root.season-selected(number);
                                }
                            }
                        }
                    }
                }
                }

                // ---- The panel on the right: episodes, then places to watch.
                if detail-view.panel: Rectangle {
                    x: root.compact ? 12px : parent.width - detail-view.panel-width - 24px;
                    y: root.compact ? detail-view.top-part : 24px;
                    width: detail-view.panel-width;
                    height: root.compact ? parent.height - detail-view.top-part - 10px : parent.height - 48px;
                    border-radius: 18px;
                    background: Theme.surface.with-alpha(0.94);
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;
                    // Clicks on the panel do not fall through to the picture.
                    TouchArea { }

                    if !detail-view.sources-shown: VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                horizontal-stretch: 1;
                                text: root.seasons.length == 0 ? "Episodes" : root.season == 0 ? "Specials" : "Season " + root.season;
                                font-family: Theme.heading-font;
                                color: Theme.text;
                                font-size: 16px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            IconButton {
                                icon: "close";
                                label: "Close the list";
                                clicked => {
                                    root.detail-panel-open = false;
                                    root.episode-open = false;
                                }
                            }
                        }
                        if root.seasons.length > 0: Rectangle {
                            height: 32px;
                            Flickable {
                                width: parent.width;
                                height: parent.height;
                                content-width: root.seasons.length * 108px;
                                content-height: self.height;
                                for number[index] in root.seasons: Chip {
                                    x: index * 108px;
                                    width: 100px;
                                    label: number == 0 ? "Specials" : "Season " + number;
                                    selected: number == root.season;
                                    clicked => { root.season-selected(number); }
                                }
                            }
                        }
                        if root.seasons.length > 0 && root.episodes.length > 0: HorizontalLayout {
                            alignment: start;
                            Chip {
                                label: root.season-all-watched ? "✓  Season watched · mark unwatched" : "Mark season watched";
                                selected: root.season-all-watched;
                                clicked => { root.season-watched(!root.season-all-watched); }
                            }
                        }
                        if root.seasons.length > 0: Field {
                            placeholder-text: "Filter episodes";
                            text <=> root.episode-filter;
                            edited(text) => { root.filter-episodes(text); }
                        }
                        if root.episodes.length == 0: Text {
                            text: "No episode matches.";
                            color: Theme.text-dim;
                        }
                        episode-scroll := ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            content-height: episode-list.preferred-height;
                            episode-list := VerticalLayout {
                                width: episode-scroll.visible-width;
                                alignment: start;
                                spacing: 8px;
                                for episode in root.episodes: EpisodeItem {
                                    episode: episode;
                                    clicked => { root.episode-selected(episode.id); }
                                    toggle-watched => { root.episode-watched(episode.id, !episode.watched); }
                                }
                            }
                        }
                    }

                    if detail-view.sources-shown: VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 10px;
                            if detail-view.is-series: Chip {
                                width: 34px;
                                label: "‹";
                                accessible-label: "Back to the episodes";
                                clicked => { root.episode-open = false; }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: detail-view.is-series && root.episode-label != "" ? root.episode-label : "Play from your sources";
                                font-family: Theme.heading-font;
                                color: Theme.text;
                                font-size: 16px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            IconButton {
                                icon: "close";
                                label: "Close the list";
                                clicked => {
                                    root.detail-panel-open = false;
                                    root.episode-open = false;
                                }
                            }
                        }
                        if root.play-note != "": Text {
                            text: root.play-note;
                            color: Theme.accent;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if root.resume-note != "": Text {
                            text: root.resume-note;
                            color: Theme.accent;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        // Narrow the list to one provider when there are several.
                        if root.stream-groups.length > 1: Rectangle {
                            height: 30px;
                            Flickable {
                                width: parent.width;
                                height: parent.height;
                                content-width: group-chips.preferred-width;
                                content-height: self.height;
                                group-chips := HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Chip {
                                        label: "All  " + root.streams.length;
                                        selected: root.stream-group == "";
                                        clicked => { root.stream-group = ""; }
                                    }
                                    for group in root.stream-groups: Chip {
                                        label: group.name + "  " + group.count;
                                        selected: root.stream-group == group.name;
                                        clicked => { root.stream-group = group.name; }
                                    }
                                }
                            }
                        }
                        if root.detail.loading && !root.streams-loading: Text {
                            text: "Loading…";
                            color: Theme.text-dim;
                            font-size: 13px;
                        }
                        if root.streams-loading: Text {
                            text: root.streams.length > 0 ? "More are still coming in…" : root.addons-hidden ? "Asking your media servers…" : "Asking your media servers and add-ons…";
                            color: Theme.text-dim;
                            font-size: 13px;
                        }
                        if root.streams-note != "": Text {
                            text: root.streams-note;
                            color: Theme.text-dim;
                            wrap: word-wrap;
                        }
                        source-scroll := ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            content-height: source-list.preferred-height;
                            // Rows of other providers take up no room.
                            source-list := VerticalLayout {
                                width: source-scroll.visible-width;
                                alignment: start;
                                for stream[index] in root.streams: stream-slot := Rectangle {
                                    // Ten per provider, under its heading; a
                                    // chosen tab leaves only that provider.
                                    private property <bool> shown: stream.shown && (root.stream-group == "" || stream.group == root.stream-group);
                                    private property <length> head: stream.heading != "" ? 34px : 0px;
                                    height: self.shown ? self.head + source-card.height + 8px + (stream.more > 0 ? 40px : 0px) : 0px;
                                    clip: true;
                                    if stream-slot.shown && stream.heading != "": Text {
                                        x: 2px;
                                        y: 4px;
                                        height: 24px;
                                        text: stream.heading;
                                        color: Theme.accent;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    source-card := SourceCard {
                                        visible: stream-slot.shown;
                                        y: stream-slot.head;
                                        stream: stream;
                                        play => { root.play-stream(index); }
                                        download => { root.download-stream(index); }
                                    }
                                    if stream-slot.shown && stream.more > 0: Chip {
                                        x: 0;
                                        y: stream-slot.head + source-card.height + 8px;
                                        label: "Show more from " + stream.group + "  (" + stream.more + " left)";
                                        clicked => { root.show-more-streams(stream.group); }
                                    }
                                }
                            }
                        }

                        // Where it plays, and the services that carry it.
                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                        Rectangle {
                            height: 30px;
                            Flickable {
                                width: parent.width;
                                height: parent.height;
                                content-width: cast-chips.preferred-width;
                                content-height: self.height;
                                cast-chips := HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: "Play on";
                                        color: Theme.text-dim;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                    Chip {
                                        label: root.mobile ? "This device" : "This computer";
                                        selected: root.cast-target < 0;
                                        clicked => { root.cast-target = -1; }
                                    }
                                    for name[index] in root.cast-devices: Chip {
                                        label: name;
                                        selected: root.cast-target == index;
                                        clicked => { root.cast-target = index; }
                                    }
                                    Chip {
                                        label: root.cast-finding ? "Looking…" : "Find Chromecasts";
                                        clicked => {
                                            if (!root.cast-finding) {
                                                root.find-cast-devices();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.cast-note != "": Text {
                            text: root.cast-note;
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                    }
                }
            }

            if !root.detail-open && root.page == root.library-page: VerticalLayout {
                padding-left: root.compact ? 16px : 32px;
                padding-right: root.compact ? 16px : 32px;
                padding-top: root.compact ? 16px : 32px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 12px;
                    PageTitle {
                        text: "Library";
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if !root.compact: Segments {
                        labels: ["Downloads", "Watchlist", "History"];
                        current <=> root.library-tab;
                    }
                }
                // A phone: the switch under the title, where it fits.
                if root.compact: HorizontalLayout {
                    alignment: start;
                    Segments {
                        labels: ["Downloads", "Watchlist", "History"];
                        current <=> root.library-tab;
                    }
                }

                // ---- Downloads: films, then series by name.
                if root.library-tab == 0: HorizontalLayout {
                    spacing: 10px;
                    Icon {
                        name: "folder";
                        size: 18px;
                        tint: Theme.text-dim;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: "Saved in " + root.downloads-folder;
                        color: Theme.text-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if !root.mobile: Button {
                        text: "Show folder";
                        clicked => { root.open-downloads-folder(); }
                    }
                }
                if root.library-tab == 0 && root.download-rows.length == 0: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: start;
                    Text {
                        text: "Nothing downloaded yet. On a film's or an episode's page, press the download button beside a place to watch: it is saved to this device and shows here, sorted into films and series.";
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                }
                if root.library-tab == 0 && root.download-rows.length > 0: dl-scroll := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: dl-list.preferred-height;
                    dl-list := VerticalLayout {
                        width: dl-scroll.visible-width;
                        alignment: start;
                        spacing: 8px;
                        padding-bottom: 16px;
                        for row in root.download-rows: VerticalLayout {
                            spacing: 8px;
                            if row.section != "": Text {
                                text: row.section;
                                font-family: Theme.heading-font;
                                color: Theme.text;
                                font-size: 18px;
                                font-weight: 700;
                            }
                            if row.group != "": Text {
                                text: row.group;
                                color: Theme.accent;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            DownloadItem {
                                item: row;
                                play => { root.download-play(row.id); }
                                toggle => { root.download-toggle(row.id); }
                                remove => { root.download-remove(row.id); }
                            }
                        }
                    }
                }

                // ---- Watchlist and History: posters.
                if root.library-tab == 1 && root.watchlist.length == 0: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: start;
                    Text {
                        text: "Nothing saved yet. Open a film or series and choose Add to Watchlist.";
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                }
                if root.library-tab == 2 && root.history.length == 0: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: start;
                    Text {
                        text: "Nothing watched yet. Films and episodes you play show here, newest first.";
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                }
                if (root.library-tab == 1 && root.watchlist.length > 0) || (root.library-tab == 2 && root.history.length > 0): grid-view := ScrollView {
                    private property <[Poster]> items: root.library-tab == 1 ? root.watchlist : root.history;
                    private property <length> step: 162px;
                    private property <length> line: 286px;
                    private property <int> columns: max(1, floor((self.visible-width + 12px) / self.step));
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: ceil(self.items.length / self.columns) * self.line + 16px;
                    for poster[index] in grid-view.items: PosterCard {
                        x: mod(index, grid-view.columns) * grid-view.step;
                        y: floor(index / grid-view.columns) * grid-view.line;
                        poster: poster;
                        remove-label: root.library-tab == 2 ? "Remove from History" : "";
                        clicked => { root.open-title(poster); }
                        remove => { root.remove-continue(poster); }
                    }
                }
            }

            if !root.detail-open && root.page == root.calendar-page: VerticalLayout {
                padding: root.compact ? 16px : 32px;
                spacing: root.compact ? 10px : 16px;

                if root.compact: HorizontalLayout {
                    spacing: 12px;
                    PageTitle {
                        text: "Calendar";
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Segments {
                        y: (parent.height - self.height) / 2;
                        labels: ["Month", "Week"];
                        current: root.calendar-is-week ? 1 : 0;
                        chosen(index) => { root.calendar-day-only = false; root.calendar-week(index == 1); }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    if !root.compact: PageTitle {
                        text: "Calendar";
                        vertical-alignment: center;
                    }
                    if !root.compact: Rectangle { width: 12px; }
                    if !root.compact: Segments {
                        y: (parent.height - self.height) / 2;
                        labels: ["Month", "Week"];
                        current: root.calendar-is-week ? 1 : 0;
                        chosen(index) => { root.calendar-day-only = false; root.calendar-week(index == 1); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: "back";
                        label: root.calendar-is-week ? "The week before" : "The month before";
                        clicked => { root.calendar-day-only = false; root.calendar-step(-1); }
                    }
                    Text {
                        width: root.compact ? 170px : 230px;
                        text: root.calendar-title;
                        font-family: Theme.heading-font;
                        color: Theme.text;
                        font-size: root.compact ? 15px : 18px;
                        overflow: elide;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: "forward";
                        label: root.calendar-is-week ? "The week after" : "The month after";
                        clicked => { root.calendar-day-only = false; root.calendar-step(1); }
                    }
                    Chip {
                        y: (parent.height - self.height) / 2;
                        height: 36px;
                        border-radius: 18px;
                        label: "Today";
                        clicked => { root.calendar-day-only = false; root.calendar-step(0); }
                    }
                }
                // A phone: the month as squares (a gold dot for each release,
                // a tick once watched); the day picked lists its releases.
                if root.compact: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    phone-month := Rectangle {
                        private property <length> across: self.width / 7;
                        // A week is one row of taller squares.
                        private property <length> line: root.calendar-is-week ? 72px : min(self.across, 58px);
                        height: 22px + (root.calendar-is-week ? 1 : 6) * self.line;
                        for name[index] in ["M", "T", "W", "T", "F", "S", "S"]: Text {
                            x: index * phone-month.across;
                            y: 0;
                            width: phone-month.across - 4px;
                            height: 18px;
                            text: name;
                            color: Theme.text-dim;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        for day[index] in root.calendar-days: phone-day := Rectangle {
                            private property <bool> picked: index == root.calendar-pick;
                            private property <bool> all-watched: day.all.length > 0 && day.all[0].watched && (day.all.length < 2 || day.all[1].watched) && (day.all.length < 3 || day.all[2].watched);
                            x: mod(index, 7) * phone-month.across;
                            y: 22px + floor(index / 7) * phone-month.line;
                            width: phone-month.across - 4px;
                            height: phone-month.line - 4px;
                            border-radius: 8px;
                            background: self.picked ? Theme.accent.with-alpha(0.22) : day.today ? Theme.selected : day.in-month ? Theme.surface : transparent;
                            border-width: self.picked || day.today ? 1.5px : 1px;
                            border-color: self.picked || day.today ? Theme.accent : day.in-month ? Theme.border : transparent;
                            accessible-role: button;
                            accessible-label: day.long-name + (day.all.length > 0 ? ", " + day.all.length + " coming out" : "");
                            accessible-action-default => { root.calendar-pick = index; }
                            TouchArea {
                                clicked => { root.calendar-pick = index; }
                            }
                            Text {
                                y: 4px;
                                width: parent.width;
                                text: day.number;
                                color: day.today || phone-day.picked ? Theme.accent : day.in-month ? Theme.text : Theme.text-dim;
                                font-size: 13px;
                                font-weight: day.today || phone-day.picked ? 700 : 500;
                                horizontal-alignment: center;
                                opacity: day.in-month ? 1 : 0.5;
                            }
                            // One dot a release (up to three), or a tick
                            // when every one shown has been watched.
                            if day.all.length > 0 && !phone-day.all-watched: HorizontalLayout {
                                y: parent.height - 14px;
                                height: 7px;
                                alignment: center;
                                spacing: 3px;
                                for n in min(day.all.length, 3): Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Theme.accent;
                                    opacity: day.in-month ? 1 : 0.55;
                                }
                            }
                            if day.all.length > 0 && phone-day.all-watched: WatchedTick {
                                x: (parent.width - self.width) / 2;
                                y: parent.height - self.height - 4px;
                                size: 16px;
                            }
                        }
                    }
                    if root.calendar-note != "": Text {
                        text: root.calendar-note;
                        color: Theme.text-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    if root.calendar-pick >= 0 && root.calendar-pick < root.calendar-days.length: Text {
                        text: root.calendar-days[root.calendar-pick].long-name;
                        font-family: Theme.heading-font;
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    phone-day-scroll := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: phone-day-list.preferred-height;
                        phone-day-list := VerticalLayout {
                            width: phone-day-scroll.visible-width;
                            alignment: start;
                            spacing: 8px;
                            if root.calendar-pick >= 0 && root.calendar-pick < root.calendar-days.length && root.calendar-days[root.calendar-pick].all.length == 0: Text {
                                text: "Nothing from your Watchlist comes out this day.";
                                color: Theme.text-dim;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            for entry in root.calendar-days[root.calendar-pick].all: Rectangle {
                                height: 58px;
                                border-radius: 12px;
                                background: phone-entry-touch.pressed ? Theme.hover : Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border;
                                accessible-role: button;
                                accessible-label: entry.title + (entry.label != "" ? ", " + entry.label : "") + (entry.watched ? ", watched" : "");
                                accessible-action-default => { root.calendar-open(entry); }
                                phone-entry-touch := TouchArea {
                                    clicked => { root.calendar-open(entry); }
                                }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 4px;
                                        height: 30px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 2px;
                                        background: Theme.accent;
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: entry.title;
                                            color: Theme.text;
                                            font-size: 14px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: entry.label != "" ? entry.label : (entry.kind == "movie" ? "Film" : "Comes out");
                                            color: Theme.text-dim;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                    if entry.time != "": Text {
                                        text: entry.time;
                                        color: Theme.accent;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    if entry.watched: WatchedTick {
                                        y: (parent.height - self.height) / 2;
                                        size: 24px;
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.calendar-zone;
                        color: Theme.text-dim;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }

                if !root.compact: HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 20px;

                    // The month, a square a day (a computer's screen only).
                    month-grid := Rectangle {
                        visible: !root.compact;
                        max-width: root.compact ? 0px : 10000px;
                        horizontal-stretch: root.compact ? 0 : 1;
                        private property <length> across: self.width / 7;
                        private property <length> line: root.calendar-is-week ? self.height - 28px : (self.height - 28px) / 6;
                        // A week's squares are tall: each release gets two lines.
                        private property <length> entry-step: root.calendar-is-week ? 46px : 19px;
                        for name[index] in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: Text {
                            x: index * month-grid.across + 8px;
                            y: 0;
                            height: 22px;
                            text: name;
                            color: Theme.text-dim;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        for day[index] in root.calendar-days: desk-day := Rectangle {
                            private property <bool> picked: root.calendar-day-only && index == root.calendar-pick;
                            x: mod(index, 7) * month-grid.across;
                            y: 28px + floor(index / 7) * month-grid.line;
                            width: month-grid.across - 6px;
                            height: month-grid.line - 6px;
                            border-radius: 10px;
                            clip: true;
                            background: self.picked ? Theme.accent.with-alpha(0.18) : day-touch.has-hover && day.in-month ? Theme.hover : day.today ? Theme.selected : day.in-month ? Theme.surface : transparent;
                            border-width: self.picked ? 2px : 1px;
                            border-color: self.picked || day.today ? Theme.accent : day.in-month ? Theme.border : transparent;
                            accessible-role: button;
                            accessible-label: day.long-name + (day.all.length > 0 ? ", " + day.all.length + " coming out" : "");
                            accessible-action-default => {
                                root.calendar-day-only = !self.picked;
                                root.calendar-pick = index;
                            }
                            // Clicking the day (not one of its titles) lists
                            // only that day beside the month; again, the whole month.
                            day-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.calendar-day-only = !desk-day.picked;
                                    root.calendar-pick = index;
                                }
                            }
                            Text {
                                x: 8px;
                                y: 5px;
                                text: day.number;
                                color: day.today ? Theme.accent : day.in-month ? Theme.text : Theme.text-dim;
                                font-size: 13px;
                                font-weight: day.today ? 700 : 500;
                                opacity: day.in-month ? 1 : 0.5;
                            }
                            for entry[line] in day.entries: Rectangle {
                                x: 5px;
                                y: 26px + line * month-grid.entry-step;
                                width: parent.width - 10px;
                                height: month-grid.entry-step - 2px;
                                border-radius: 4px;
                                background: entry-touch.has-hover ? Theme.accent : Theme.accent.with-alpha(0.16);
                                opacity: day.in-month ? 1 : 0.55;
                                entry-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.calendar-open(entry); }
                                }
                                if entry.watched: WatchedTick {
                                    x: parent.width - self.width - 3px;
                                    y: root.calendar-is-week ? 3px : (parent.height - self.height) / 2;
                                    size: root.calendar-is-week ? 18px : 14px;
                                }
                                Text {
                                    x: 5px;
                                    y: root.calendar-is-week ? 4px : 0px;
                                    width: parent.width - (entry.watched ? 28px : 10px);
                                    height: root.calendar-is-week ? 18px : parent.height;
                                    text: entry.title;
                                    color: entry-touch.has-hover ? (Theme.dark ? #171a22 : #ffffff) : Theme.text;
                                    font-size: root.calendar-is-week ? 12px : 11px;
                                    font-weight: root.calendar-is-week ? 600 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if root.calendar-is-week: Text {
                                    x: 5px;
                                    y: 22px;
                                    width: parent.width - 10px;
                                    height: 16px;
                                    text: (entry.time != "" ? entry.time + "  " : "") + (entry.label != "" ? entry.label : "Film");
                                    color: entry-touch.has-hover ? (Theme.dark ? #171a22 : #ffffff) : Theme.text-dim;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            if day.more > 0: Text {
                                x: 8px;
                                y: 26px + day.entries.length * month-grid.entry-step;
                                text: "+" + day.more + " more";
                                color: Theme.text-dim;
                                font-size: 11px;
                            }
                        }
                    }

                    // The same month as a list, with episodes and times.
                    Rectangle {
                        horizontal-stretch: root.compact ? 1 : 0;
                        min-width: root.compact ? 0px : 330px;
                        max-width: root.compact ? 10000px : 330px;
                        border-radius: 18px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.calendar-day-only ? root.calendar-days[root.calendar-pick].long-name : root.calendar-is-week ? "This week" : "This month";
                                    font-family: Theme.heading-font;
                                    color: Theme.text;
                                    font-size: 16px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if root.calendar-day-only: Chip {
                                    height: 30px;
                                    border-radius: 15px;
                                    label: root.calendar-is-week ? "Whole week" : "Whole month";
                                    clicked => { root.calendar-day-only = false; }
                                }
                            }
                            if root.calendar-note != "" && !root.calendar-day-only: Text {
                                text: root.calendar-note;
                                color: Theme.text-dim;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            // The day clicked: only what comes out then.
                            if root.calendar-day-only: day-scroll := ScrollView {
                                vertical-stretch: 1;
                                content-width: self.visible-width;
                                content-height: day-list.preferred-height;
                                day-list := VerticalLayout {
                                    width: day-scroll.visible-width;
                                    alignment: start;
                                    spacing: 6px;
                                    if root.calendar-days[root.calendar-pick].all.length == 0: Text {
                                        text: "Nothing from your Watchlist comes out this day.";
                                        color: Theme.text-dim;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                    for entry in root.calendar-days[root.calendar-pick].all: Rectangle {
                                        height: 48px;
                                        border-radius: 10px;
                                        background: day-entry-touch.has-hover ? Theme.hover : Theme.background.with-alpha(0.55);
                                        border-width: 1px;
                                        border-color: day-entry-touch.has-hover ? Theme.accent : Theme.border;
                                        day-entry-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.calendar-open(entry); }
                                        }
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 10px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: entry.title;
                                                    color: Theme.text;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: entry.label != "" ? entry.label : (entry.kind == "movie" ? "Film" : "Comes out");
                                                    color: Theme.text-dim;
                                                    font-size: 12px;
                                                    overflow: elide;
                                                }
                                            }
                                            if entry.watched: WatchedTick {
                                                y: (parent.height - self.height) / 2;
                                                size: 20px;
                                            }
                                            Text {
                                                text: entry.time;
                                                color: Theme.accent;
                                                font-size: 13px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                            if !root.calendar-day-only: agenda-scroll := ScrollView {
                                vertical-stretch: 1;
                                content-width: self.visible-width;
                                content-height: agenda-list.preferred-height;
                                agenda-list := VerticalLayout {
                                    width: agenda-scroll.visible-width;
                                    alignment: start;
                                    for row in root.calendar-agenda: agenda-slot := Rectangle {
                                        private property <length> head: row.heading != "" ? 30px : 0px;
                                        height: self.head + 54px;
                                        opacity: row.past ? 0.55 : 1;
                                        if row.heading != "": Text {
                                            x: 2px;
                                            y: 6px;
                                            height: 20px;
                                            text: row.today ? row.heading + "  ·  Today" : row.heading;
                                            color: Theme.accent;
                                            font-size: 13px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            y: agenda-slot.head;
                                            height: 48px;
                                            border-radius: 10px;
                                            background: agenda-touch.has-hover ? Theme.hover : Theme.background.with-alpha(0.55);
                                            border-width: 1px;
                                            border-color: agenda-touch.has-hover ? Theme.accent : Theme.border;
                                            agenda-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.calendar-open(row.entry); }
                                            }
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                spacing: 10px;
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text {
                                                        text: row.entry.title;
                                                        color: Theme.text;
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: row.entry.label != "" ? row.entry.label : (row.entry.kind == "movie" ? "Film" : "Comes out");
                                                        color: Theme.text-dim;
                                                        font-size: 12px;
                                                        overflow: elide;
                                                    }
                                                }
                                                if row.entry.watched: WatchedTick {
                                                    y: (parent.height - self.height) / 2;
                                                    size: 20px;
                                                }
                                                Text {
                                                    text: row.entry.time;
                                                    color: Theme.accent;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Text {
                                text: root.calendar-zone;
                                color: Theme.text-dim;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            if !root.detail-open && root.page == root.tv-page && root.live-band == 0: ChannelsPage {
                title: "Live TV";
                band <=> root.live-band;
                compact: root.compact;
                hint: "Add an M3U playlist or an Xtream Codes account in Settings, under Connections > Live TV, to see the channels here.";
                channels: root.tv-channels;
                categories: root.tv-categories;
                total: root.tv-total;
                category <=> root.tv-category;
                words <=> root.tv-words;
                can-play: root.can-play-channels;
                filter(words, category) => { root.filter-channels(false, words, category); }
                filter-categories(words) => { root.filter-categories(false, words); }
                play(index) => { root.play-channel(false, index); }
                star(index) => { root.fav-pick(false, index); }
                make-group(name) => { root.fav-new-group(name); }
                delete-group(name) => { root.fav-delete-group(name); }

                if root.tv-total == 0: HorizontalLayout {
                    alignment: start;
                    PrimaryButton {
                        text: "Open Settings";
                        clicked => {
                            root.settings-section = 4;
                            root.settings-picking = false;
                            root.page = root.settings-page;
                            root.page-selected(root.settings-page);
                        }
                    }
                }
            }
            if !root.detail-open && root.page == root.tv-page && root.live-band == 1: ChannelsPage {
                title: "Live TV";
                band <=> root.live-band;
                compact: root.compact;
                hint: "Stations marked as radio in your Live TV sources show here.";
                channels: root.radio-channels;
                categories: root.radio-categories;
                total: root.radio-total;
                category <=> root.radio-category;
                words <=> root.radio-words;
                can-play: root.can-play-channels;
                filter(words, category) => { root.filter-channels(true, words, category); }
                filter-categories(words) => { root.filter-categories(true, words); }
                play(index) => { root.play-channel(true, index); }
                star(index) => { root.fav-pick(true, index); }
                make-group(name) => { root.fav-new-group(name); }
                delete-group(name) => { root.fav-delete-group(name); }
            }

            if !root.detail-open && root.page == root.home-page && !root.home-has-sources: VerticalLayout {
                padding: 32px;
                spacing: 12px;
                alignment: start;

                PageTitle { text: "Home"; }
                Text {
                    text: root.addons-hidden
                        ? "Home fills with shelves of films and series from your media servers and the TMDB catalogue. Add a media server or a TMDB key in Settings."
                        : "Home fills with shelves of films and series from your media servers, your add-ons and the TMDB catalogue. Add a media server or a TMDB key in Settings, or install an add-on.";
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    PrimaryButton {
                        text: "Open Settings";
                        clicked => {
                            root.page = root.settings-page;
                            root.page-selected(root.settings-page);
                        }
                    }
                    if !root.addons-hidden: Button {
                        text: "Add-ons";
                        clicked => {
                            root.settings-section = 3;
                            root.settings-picking = false;
                            root.page = root.settings-page;
                            root.page-selected(root.settings-page);
                        }
                    }
                }
                if root.continue-shelf.items.length > 0: ShelfRow {
                    shelf: root.continue-shelf;
                    remove-label: "Remove from Continue Watching";
                    open(poster) => { root.open-title(poster); }
                    remove(poster) => { root.remove-continue(poster); }
                }
            }
            if !root.detail-open && root.page == root.home-page && root.home-has-sources: home := ScrollView {
                // Two wide cards across a phone, as in Strand.
                private property <length> card-w: root.compact ? (self.visible-width - 32px - 14px) / 2 : 328px;
                private property <length> card-h: home.card-w * 0.5625;
                // The pull-to-refresh strip above the top (RefreshStrip).
                private property <length> zone: 64px;
                private property <bool> busy: root.home-refreshing;
                content-width: self.visible-width;
                content-height: max(self.visible-height, home-content.preferred-height) + self.zone;
                init => { self.content-y = -self.zone; }
                changed content-y => {
                    if (self.content-y > -4px && !self.busy) {
                        root.home-refresh();
                    }
                }
                // Done: the strip goes back out of sight (if it shows).
                changed busy => {
                    if (!self.busy && self.content-y > -self.zone) {
                        self.content-y = -self.zone;
                    }
                }
                RefreshStrip {
                    y: 0;
                    width: home.visible-width;
                    height: home.zone;
                    busy: home.busy;
                    reveal: (home.zone + home.content-y) / home.zone;
                }

                home-content := VerticalLayout {
                    y: home.zone;
                    width: home.visible-width;
                    padding: root.compact ? 16px : 32px;
                    padding-top: root.compact ? 12px : 24px;
                    spacing: 28px;
                    alignment: start;

                    // ---- The banner: a few titles in turn, large.
                    if root.hero.length > 0: VerticalLayout {
                        spacing: 14px;
                        hero-card := Rectangle {
                            private property <HeroSlide> slide: root.hero[root.hero-index];
                            // A phone gets a tall card, as in Strand.
                            height: root.compact ? clamp(home.visible-width * 1.2, 420px, 560px) : clamp(home.visible-width * 0.40, 340px, 580px);
                            border-radius: 24px;
                            clip: true;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            accessible-role: button;
                            accessible-label: self.slide.title;
                            hero-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-title({ id: hero-card.slide.id, kind: hero-card.slide.kind, title: hero-card.slide.title });
                                }
                            }
                            if hero-card.slide.has-image: Image {
                                width: 100%;
                                height: 100%;
                                source: hero-card.slide.image;
                                image-fit: cover;
                            }
                            Rectangle {
                                background: @linear-gradient(180deg, transparent 35%, #0d0f14e6 100%);
                            }
                            Rectangle {
                                background: @linear-gradient(90deg, #0d0f14b3 0%, transparent 60%);
                            }
                            VerticalLayout {
                                x: root.compact ? 20px : 40px;
                                width: root.compact ? parent.width - 40px : min(parent.width - 80px, 720px);
                                padding-bottom: root.compact ? 22px : 34px;
                                spacing: 10px;
                                alignment: end;
                                Text {
                                    text: hero-card.slide.title;
                                    color: #ffffff;
                                    font-size: root.compact ? 30px : clamp(hero-card.height * 0.11, 34px, 60px);
                                    font-weight: 800;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    max-height: root.compact ? 76px : 150px;
                                    horizontal-alignment: root.compact ? center : left;
                                }
                                if hero-card.slide.facts != "": Text {
                                    text: hero-card.slide.facts;
                                    color: #f2f3f7;
                                    horizontal-alignment: root.compact ? center : left;
                                    font-size: root.compact ? 13px : 15px;
                                    font-weight: 600;
                                }
                                if hero-card.slide.description != "": Text {
                                    text: hero-card.slide.description;
                                    color: #d5d8e0;
                                    font-size: root.compact ? 13px : 14px;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    max-height: 40px;
                                    horizontal-alignment: root.compact ? center : left;
                                }
                                HorizontalLayout {
                                    alignment: root.compact ? center : start;
                                    padding-top: 6px;
                                    Rectangle {
                                        width: more-label.preferred-width + 76px;
                                        height: 42px;
                                        border-radius: 21px;
                                        background: more-touch.has-hover ? Theme.accent.brighter(0.1) : Theme.accent;
                                        accessible-role: button;
                                        accessible-label: "Info about " + hero-card.slide.title;
                                        more-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.open-title({ id: hero-card.slide.id, kind: hero-card.slide.kind, title: hero-card.slide.title });
                                            }
                                        }
                                        Icon {
                                            x: 20px;
                                            name: "info";
                                            size: 18px;
                                            tint: #171a22;
                                        }
                                        more-label := Text {
                                            x: 46px;
                                            text: "Info";
                                            color: #171a22;
                                            font-size: 14px;
                                            font-weight: 700;
                                        }
                                    }
                                }
                            }
                            if root.hero.length > 1 && !root.compact: IconButton {
                                x: parent.width - 2 * 44px - 28px;
                                y: parent.height - 44px - 30px;
                                size: 44px;
                                icon: "back";
                                label: "The title before";
                                clicked => { root.hero-index = mod(root.hero-index - 1 + root.hero.length, root.hero.length); }
                            }
                            if root.hero.length > 1 && !root.compact: IconButton {
                                x: parent.width - 44px - 20px;
                                y: parent.height - 44px - 30px;
                                size: 44px;
                                icon: "forward";
                                label: "The next title";
                                clicked => { root.hero-index = mod(root.hero-index + 1, root.hero.length); }
                            }
                            Timer {
                                interval: 9s;
                                running: root.home-showing && root.hero.length > 1 && !hero-touch.has-hover;
                                triggered => { root.hero-index = mod(root.hero-index + 1, root.hero.length); }
                            }
                        }
                        // Which title shows, as dots.
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            for slide[index] in root.hero: Rectangle {
                                width: index == root.hero-index ? 30px : 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: index == root.hero-index ? Theme.text : Theme.text-dim.with-alpha(0.5);
                                animate width { duration: 200ms; }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.hero-index = index; }
                                }
                            }
                        }
                    }

                    // ---- Upcoming: what comes out from the Watchlist.
                    if root.upcoming.length > 0: VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            Text {
                                text: "Upcoming";
                                font-family: Theme.heading-font;
                                color: Theme.text;
                                font-size: 20px;
                                font-weight: 700;
                            }
                            Rectangle {
                                width: 26px;
                                accessible-role: button;
                                accessible-label: "Open the Calendar";
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.page = root.calendar-page;
                                        root.page-selected(root.calendar-page);
                                    }
                                }
                                Icon {
                                    name: "forward";
                                    size: 18px;
                                    tint: Theme.text-dim;
                                }
                            }
                        }
                        Rectangle {
                            height: home.card-h + 64px;
                            Flickable {
                                width: parent.width;
                                height: parent.height;
                                content-width: root.upcoming.length * (home.card-w + 16px);
                                content-height: self.height;
                                for card[index] in root.upcoming: Rectangle {
                                    x: index * (home.card-w + 16px);
                                    width: home.card-w;
                                    height: home.card-h + 64px;
                                    accessible-role: button;
                                    accessible-label: card.title + ", " + card.episode + ", " + card.when;
                                    card-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.open-title({ id: card.id, kind: card.kind, title: card.title, video: card.video });
                                        }
                                    }
                                    Rectangle {
                                        y: 0;
                                        height: home.card-h;
                                        border-radius: 16px;
                                        clip: true;
                                        background: Theme.surface;
                                        border-width: card-touch.has-hover ? 2px : 1px;
                                        border-color: card-touch.has-hover ? Theme.accent : Theme.border;
                                        if card.has-image: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: card.image;
                                            image-fit: cover;
                                        }
                                        Rectangle {
                                            background: @linear-gradient(180deg, transparent 50%, #00000099 100%);
                                        }
                                        if card.badge != "": Text {
                                            x: 16px;
                                            y: parent.height - (root.compact ? 30px : 38px);
                                            text: card.badge;
                                            color: #ffffff;
                                            font-size: root.compact ? 12px : 15px;
                                            font-weight: 800;
                                        }
                                        Rectangle {
                                            x: parent.width - self.width - 12px;
                                            y: parent.height - (root.compact ? 32px : 40px);
                                            width: when-label.preferred-width + (root.compact ? 14px : 24px);
                                            height: root.compact ? 24px : 28px;
                                            border-radius: self.height / 2;
                                            background: card.soon ? Theme.accent : #000000a0;
                                            when-label := Text {
                                                text: card.when;
                                                color: card.soon ? #171a22 : #ffffff;
                                                font-size: root.compact ? 11px : 13px;
                                                font-weight: 700;
                                            }
                                        }
                                    }
                                    Text {
                                        y: home.card-h + 10px;
                                        width: 100%;
                                        text: card.title;
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        y: home.card-h + 34px;
                                        width: 100%;
                                        text: card.episode;
                                        color: Theme.text-dim;
                                        font-size: 13px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }


                    // ---- Continue Watching: wide cards, as Upcoming.
                    if root.continue-cards.length > 0: VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            Text {
                                text: "Continue Watching";
                                font-family: Theme.heading-font;
                                color: Theme.text;
                                font-size: 20px;
                                font-weight: 700;
                            }
                            Rectangle {
                                width: 26px;
                                accessible-role: button;
                                accessible-label: "Open your History";
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.library-tab = 2;
                                        root.page = root.library-page;
                                        root.page-selected(root.library-page);
                                    }
                                }
                                Icon {
                                    name: "forward";
                                    size: 18px;
                                    tint: Theme.text-dim;
                                }
                            }
                        }
                        Rectangle {
                            height: home.card-h + 64px;
                            Flickable {
                                width: parent.width;
                                height: parent.height;
                                content-width: root.continue-cards.length * (home.card-w + 16px);
                                content-height: self.height;
                                for card[index] in root.continue-cards: Rectangle {
                                    x: index * (home.card-w + 16px);
                                    width: home.card-w;
                                    height: home.card-h + 64px;
                                    accessible-role: button;
                                    accessible-label: card.title + (card.episode != "" ? ", " + card.episode : "");
                                    cw-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.open-title({ id: card.id, kind: card.kind, title: card.title, video: card.video });
                                        }
                                    }
                                    ContextMenuArea {
                                        Menu {
                                            MenuItem {
                                                title: "Remove from Continue Watching";
                                                activated => { root.remove-continue({ id: card.id, kind: card.kind }); }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        y: 0;
                                        height: home.card-h;
                                        border-radius: 16px;
                                        clip: true;
                                        background: Theme.surface;
                                        border-width: cw-touch.has-hover ? 2px : 1px;
                                        border-color: cw-touch.has-hover ? Theme.accent : Theme.border;
                                        if card.has-image: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: card.image;
                                            image-fit: cover;
                                        }
                                        Rectangle {
                                            background: @linear-gradient(180deg, transparent 50%, #000000a6 100%);
                                        }
                                        if card.badge != "": Text {
                                            x: 16px;
                                            y: parent.height - (root.compact ? 32px : 42px);
                                            text: card.badge;
                                            color: #ffffff;
                                            font-size: root.compact ? 12px : 15px;
                                            font-weight: 800;
                                        }
                                        if card.left > 0: Rectangle {
                                            x: parent.width - self.width - 12px;
                                            y: 12px;
                                            width: max(28px, left-label.preferred-width + 16px);
                                            height: 28px;
                                            border-radius: 14px;
                                            background: #000000b3;
                                            accessible-role: text;
                                            accessible-label: card.left == 1 ? "1 episode left" : card.left + " episodes left";
                                            left-label := Text {
                                                text: card.left;
                                                color: #ffffff;
                                                font-size: 13px;
                                                font-weight: 800;
                                            }
                                        }
                                        // How far it was watched.
                                        Rectangle {
                                            x: 12px;
                                            y: parent.height - 12px;
                                            width: parent.width - 24px;
                                            height: 4px;
                                            border-radius: 2px;
                                            background: #ffffff40;
                                            Rectangle {
                                                x: 0;
                                                width: parent.width * clamp(card.progress, 0, 1);
                                                border-radius: 2px;
                                                background: Theme.accent;
                                            }
                                        }
                                    }
                                    Text {
                                        y: home.card-h + 10px;
                                        width: 100%;
                                        text: card.title;
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        y: home.card-h + 34px;
                                        width: 100%;
                                        text: card.episode;
                                        color: Theme.text-dim;
                                        font-size: 13px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                    // ---- Watchlist: posters.
                    if root.watchlist.length > 0: VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            Text {
                                text: "Watchlist";
                                font-family: Theme.heading-font;
                                color: Theme.text;
                                font-size: 20px;
                                font-weight: 700;
                            }
                            Rectangle {
                                width: 26px;
                                accessible-role: button;
                                accessible-label: "Open your Watchlist";
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.library-tab = 1;
                                        root.page = root.library-page;
                                        root.page-selected(root.library-page);
                                    }
                                }
                                Icon {
                                    name: "forward";
                                    size: 18px;
                                    tint: Theme.text-dim;
                                }
                            }
                        }
                        Rectangle {
                            height: 270px;
                            Flickable {
                                width: parent.width;
                                height: parent.height;
                                content-width: root.watchlist.length * 162px;
                                content-height: self.height;
                                for poster[index] in root.watchlist: PosterCard {
                                    x: index * 162px;
                                    poster: poster;
                                    clicked => { root.open-title(poster); }
                                }
                            }
                        }
                    }
                    if root.shelves.length == 0 && root.server-shelves.length == 0 && root.catalog-shelves.length == 0: Text {
                        text: root.servers.length > 0 ? "Waiting for your media servers…" : root.addons-hidden ? "Nothing to show here yet." : "Your add-ons have no catalogues to show here.";
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    // Your own libraries first, then add-ons, then TMDB. The
                    // rows carry their own gap, so a hidden (empty) one
                    // leaves none behind.
                    VerticalLayout {
                        spacing: 0px;
                        for shelf in root.server-shelves: ShelfRow {
                            shelf: shelf;
                            hide-empty: true;
                            gap: 28px;
                            open(poster) => { root.open-title(poster); }
                        }
                        for shelf in root.shelves: ShelfRow {
                            shelf: shelf;
                            gap: 28px;
                            open(poster) => { root.open-title(poster); }
                        }
                        for shelf in root.catalog-shelves: ShelfRow {
                            shelf: shelf;
                            gap: 28px;
                            open(poster) => { root.open-title(poster); }
                        }
                    }
                }
            }

            if !root.detail-open && root.page == root.explore-page: VerticalLayout {
                padding-left: root.compact ? 16px : 32px;
                padding-right: root.compact ? 16px : 32px;
                padding-top: root.compact ? 16px : 32px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 16px;
                    PageTitle {
                        text: "Explore";
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        max-width: 560px;
                        height: 40px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 20px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: search-box.has-focus ? Theme.accent : Theme.border;
                        Icon {
                            x: 14px;
                            name: "search";
                            size: 18px;
                            tint: Theme.text-dim;
                        }
                        search-box := TextInput {
                            x: 42px;
                            width: parent.width - 42px - (root.explore-searching || Device.touch ? 40px : 16px);
                            height: parent.height;
                            text <=> root.search-query;
                            color: Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            single-line: true;
                            accessible-role: text-input;
                            accessible-label: "Search films and series";
                            accepted => {
                                root.explore-searching = self.text != "";
                                root.search(self.text);
                            }
                        }
                        if root.search-query == "": Text {
                            x: 42px;
                            text: "Search films and series";
                            color: Theme.text-dim;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        if Device.touch && root.search-query == "": Rectangle {
                            x: parent.width - 36px;
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            accessible-role: button;
                            accessible-label: "Paste";
                            TouchArea {
                                clicked => {
                                    search-box.paste();
                                    if (search-box.text != "") {
                                        root.explore-searching = true;
                                        root.search(search-box.text);
                                    }
                                }
                            }
                            Icon {
                                name: "paste";
                                size: 16px;
                                tint: Theme.text-dim;
                            }
                        }
                        if root.explore-searching || root.search-query != "": Rectangle {
                            x: parent.width - 36px;
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: clear-touch.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-label: "Clear the search";
                            clear-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.search-query = "";
                                    root.explore-searching = false;
                                    root.search("");
                                }
                            }
                            Icon {
                                name: "close";
                                size: 14px;
                                tint: Theme.text-dim;
                            }
                        }
                    }
                }
                if root.explore-searching: search-view := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: search-content.preferred-height;
                    search-content := VerticalLayout {
                        width: search-view.visible-width;
                        spacing: 20px;
                        padding-bottom: 16px;
                        alignment: start;
                        if root.search-note != "": Text {
                            text: root.search-note;
                            color: Theme.text-dim;
                            wrap: word-wrap;
                        }
                        for shelf in root.search-shelves: ShelfRow {
                            shelf: shelf;
                            open(poster) => { root.open-title(poster); }
                        }
                    }
                }
                if !root.explore-searching && root.explore-count > 0 && root.compact: HorizontalLayout {
                    alignment: start;
                    Chip {
                        label: root.explore-picking ? "‹  Back to the titles" : "Sources  ›";
                        selected: root.explore-picking;
                        clicked => { root.explore-picking = !root.explore-picking; }
                    }
                }
                if !root.explore-searching && root.explore-count == 0: Text {
                    text: root.addons-hidden
                        ? "Explore browses everything you can watch. Add a media server or a TMDB key in Settings and it shows here."
                        : "Explore browses everything you can watch. Add a media server or a TMDB key in Settings, or install an add-on, and it shows here.";
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                if !root.explore-searching && root.explore-count == 0: Rectangle { vertical-stretch: 1; }
                if !root.explore-searching && root.explore-count > 0: HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: root.compact ? 0px : 20px;
                    // Where to browse: every source, under where it comes from.
                    VerticalLayout {
                        visible: !root.compact || root.explore-picking;
                        horizontal-stretch: root.compact && root.explore-picking ? 1 : 0;
                        min-width: root.compact ? 0px : 270px;
                        max-width: root.compact ? (root.explore-picking ? 10000px : 0px) : 270px;
                        spacing: 8px;
                        padding-bottom: 16px;
                        Field {
                            placeholder-text: "Find a source";
                            accessible-label: "Find a source";
                            edited(text) => { root.explore-filter(text); }
                        }
                        ListView {
                            vertical-stretch: 1;
                            for row in root.explore-sources: Rectangle {
                                height: row.header ? 30px : 34px;
                                if row.header: Text {
                                    x: 4px;
                                    width: parent.width - 8px;
                                    y: 8px;
                                    text: row.label;
                                    color: Theme.accent;
                                    font-size: 11px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                if !row.header: SideItem {
                                    width: parent.width;
                                    label: row.label;
                                    selected: row.index == root.explore-source;
                                    clicked => {
                                        root.explore-source = row.index;
                                        root.explore-kind = 0;
                                        root.explore-genre = -1;
                                        root.explore-pick(row.index, 0, -1);
                                        root.explore-picking = false;
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        visible: !(root.compact && root.explore-picking);
                        horizontal-stretch: root.compact && root.explore-picking ? 0 : 1;
                        max-width: root.compact && root.explore-picking ? 0px : 10000px;
                        spacing: 10px;
                        // Films or series, and the genre, where the source has them.
                        if root.explore-kinds.length > 0 || root.explore-genres.length > 0: HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            for label[index] in root.explore-kinds: Chip {
                                label: label;
                                selected: root.explore-kind == index;
                                clicked => {
                                    root.explore-kind = index;
                                    root.explore-genre = -1;
                                    root.explore-pick(root.explore-source, index, -1);
                                }
                            }
                            // The first choice stands for every genre.
                            if root.explore-genres.length > 0: ComboBox {
                                width: 230px;
                                model: root.explore-genres;
                                current-index: root.explore-genre + 1;
                                accessible-label: "Genre";
                                selected => {
                                    root.explore-genre = self.current-index - 1;
                                    root.explore-pick(root.explore-source, root.explore-kind, self.current-index - 1);
                                }
                            }
                        }
                        if root.explore-note != "" || (root.explore-loading && root.explore-items.length == 0): Text {
                            text: root.explore-note != "" ? root.explore-note : "Loading…";
                            color: Theme.text-dim;
                            overflow: elide;
                        }
                          explore-view := ScrollView {
                            private property <length> step: 162px;
                            private property <length> line: 286px;
                            private property <int> columns: max(1, floor((self.visible-width + 12px) / self.step));
                            private property <length> grid-height: ceil(root.explore-items.length / self.columns) * self.line;
                            // The pull-to-refresh strip above the top (RefreshStrip).
                            private property <length> zone: 64px;
                            private property <bool> busy: root.explore-refreshing;
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            content-height: max(self.visible-height, self.grid-height + 64px) + self.zone;
                            init => { self.content-y = -self.zone; }
                            changed content-y => {
                                if (self.content-y > -4px && !self.busy && root.explore-items.length > 0) {
                                    root.explore-refresh();
                                }
                            }
                            changed busy => {
                                if (!self.busy && self.content-y > -self.zone) {
                                    self.content-y = -self.zone;
                                }
                            }
                            RefreshStrip {
                                y: 0;
                                width: explore-view.visible-width;
                                height: explore-view.zone;
                                busy: explore-view.busy;
                                reveal: (explore-view.zone + explore-view.content-y) / explore-view.zone;
                            }

                            for poster[index] in root.explore-items: PosterCard {
                                x: mod(index, explore-view.columns) * explore-view.step;
                                y: explore-view.zone + floor(index / explore-view.columns) * explore-view.line;
                                poster: poster;
                                clicked => { root.open-title(poster); }
                            }
                            if root.explore-more && root.explore-items.length > 0: Button {
                                x: 0px;
                                y: explore-view.zone + explore-view.grid-height + 8px;
                                text: root.explore-loading ? "Loading…" : "Load more";
                                enabled: !root.explore-loading;
                                clicked => { root.explore-load-more(); }
                            }
                        }
                    }
                }
            }

            if !root.detail-open && root.page == root.settings-page: HorizontalLayout {
                padding-left: root.compact ? 16px : 32px;
                padding-top: root.compact ? 16px : 32px;
                spacing: root.compact ? 0px : 28px;

                // The parts of Settings, under their groups.
                VerticalLayout {
                    visible: !root.compact || root.settings-picking;
                    horizontal-stretch: root.compact && root.settings-picking ? 1 : 0;
                    min-width: root.compact ? 0px : 230px;
                    max-width: root.compact ? (root.settings-picking ? 10000px : 0px) : 230px;
                    padding-right: root.compact ? 16px : 0px;
                    spacing: 2px;
                    alignment: start;
                    PageTitle { text: "Settings"; }
                    Rectangle { height: 10px; }
                    for item in [
                        { head: "General", icon: "", label: "", index: -1 },
                        { head: "", icon: "general", label: "General", index: 0 },
                        { head: "", icon: "storage", label: "Downloads & storage", index: 5 },
                        { head: "Connections", icon: "", label: "", index: -1 },
                        { head: "", icon: "account", label: "Accounts", index: 1 },
                        { head: "", icon: "sync", label: "Sync options", index: 7 },
                        { head: "", icon: "server", label: "Media servers", index: 2 },
                        { head: "", icon: "addon", label: "Add-ons", index: 3 },
                        { head: "", icon: "livetv", label: "Live TV", index: 4 },
                        { head: "Haven", icon: "", label: "", index: -1 },
                        { head: "", icon: "info", label: "About", index: 6 },
                    ]: item-slot := Rectangle {
                        private property <bool> listed: !(root.addons-hidden && item.index == 3);
                        private property <bool> on: !root.compact && item.index == root.settings-section;
                        height: !self.listed ? 0px : item.head != "" ? 36px : 42px;
                        if item.head != "": Text {
                            x: 12px;
                            y: 16px;
                            text: item.head;
                            color: Theme.text-dim;
                            font-size: 11px;
                            font-weight: 700;
                        }
                        if item.head == "" && item-slot.listed: Rectangle {
                            border-radius: 10px;
                            background: item-slot.on ? Theme.selected : item-touch.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-label: item.label;
                            item-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.settings-section = item.index;
                                    root.settings-picking = false;
                                    root.settings-scroll = 0px;
                                }
                            }
                            Rectangle {
                                x: 0;
                                width: 3px;
                                height: 18px;
                                border-radius: 1.5px;
                                background: item-slot.on ? Theme.accent : transparent;
                            }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 12px;
                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    name: item.icon;
                                    size: 18px;
                                    tint: item-slot.on ? Theme.accent : Theme.text-dim;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: item.label;
                                    color: item-slot.on ? Theme.text : Theme.text-dim;
                                    font-size: 14px;
                                    font-weight: item-slot.on ? 700 : 500;
                                    vertical-alignment: center;
                                }
                                if root.compact: Icon {
                                    y: (parent.height - self.height) / 2;
                                    name: "forward";
                                    size: 16px;
                                    tint: Theme.text-dim;
                                }
                            }
                        }
                    }
                }

                // The part chosen.
                settings-view := ScrollView {
                    visible: !root.compact || !root.settings-picking;
                    horizontal-stretch: 1;
                    max-width: root.compact && root.settings-picking ? 0px : 100000px;
                    content-y <=> root.settings-scroll;
                    content-width: self.visible-width;
                    content-height: settings-content.preferred-height;

                    settings-content := VerticalLayout {
                        width: settings-view.visible-width;
                        padding-right: root.compact ? 16px : 32px;
                        padding-bottom: 24px;
                        spacing: 16px;
                        alignment: start;

                        if root.compact: HorizontalLayout {
                            alignment: start;
                            Chip {
                                label: "‹  Settings";
                                clicked => { root.settings-picking = true; }
                            }
                        }
                        Text {
                            text: ["General", "Accounts", "Media servers", "Add-ons", "Live TV", "Downloads & storage", "About", "Sync options"][root.settings-section];
                            font-family: Theme.heading-font;
                            color: Theme.text;
                            font-size: root.compact ? 22px : 26px;
                            font-weight: 700;
                            height: root.compact ? 30px : 46px;
                            vertical-alignment: center;
                        }

                        // ---- General
                        if root.settings-section == 0: VerticalLayout {
                            spacing: 20px;
                            SettingsCard {
                                title: "Appearance";
                    SettingsRow {
                        label: "Dark theme";
                        detail: "Switch between the dark and light look.";
                        Switch {
                            checked: root.dark;
                            accessible-label: "Dark theme";
                            toggled => {
                                root.dark = self.checked;
                                root.dark-toggled(self.checked);
                            }
                        }
                    }
                            }
                            SettingsCard {
                                title: "Where to watch";
                    SettingsRow {
                        label: "Country";
                        detail: "Set from this device's region unless you pick one. A title's page lists the streaming services and shops that have it in this country; if none does, Haven looks in the United States, the United Kingdom, Canada and Australia.";
                        ComboBox {
                            width: 240px;
                            model: root.countries;
                            current-index: root.country-index;
                            accessible-label: "Country";
                            selected => {
                                root.country-index = self.current-index;
                                root.country-selected(self.current-index);
                            }
                        }
                    }
                            }
                            SettingsCard {
                                title: "Player";
                    if !root.mobile: SettingsRow {
                        label: "Play videos with";
                        detail: root.player-own-works || root.player-choice != 0
                            ? "Haven's own player keeps your place and plays the next episode; another program does not."
                            : "Haven's own player cannot run on this computer, so VLC is used.";
                        ComboBox {
                            width: 190px;
                            model: ["Haven's own player", "VLC", "mpv", "Another program"];
                            current-index: root.player-choice;
                            selected => {
                                root.player-choice = self.current-index;
                                root.set-player-choice(self.current-index);
                            }
                        }
                    }
                    if !root.mobile && root.player-choice == 3: Field {
                        placeholder-text: "The program, for example C:\\Program Files\\MPC-HC\\mpc-hc64.exe";
                        text: root.player-program;
                        accessible-label: "The program to play videos with";
                        edited(text) => { root.set-player-program(text); }
                    }
                    if root.mobile && !root.ios: Text {
                        text: "Videos open in a player app on this device, such as VLC or mpv. Android asks which one the first time.";
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    if root.ios: SettingsRow {
                        label: "Play videos with";
                        detail: "Videos open in this app, which has to be installed.";
                        ComboBox {
                            width: 150px;
                            model: ["VLC", "Infuse", "Outplayer"];
                            current-index: max(0, root.player-choice - 1);
                            selected => {
                                root.player-choice = self.current-index + 1;
                                root.set-player-choice(self.current-index + 1);
                            }
                        }
                    }
                    SettingsRow {
                        label: "Send surround sound to a receiver untouched";
                        detail: "For an AV receiver or soundbar on HDMI: needed for Dolby Atmos and DTS:X.";
                        Switch {
                            checked: root.player-passthrough;
                            accessible-label: "Send surround sound to a receiver untouched";
                            toggled => { root.player-set-passthrough(self.checked); }
                        }
                    }
                    Text {
                        text: "Off, Haven decodes the sound itself and plays it on whatever this computer has, in surround where the device can. On, Dolby Digital, Dolby TrueHD and DTS sound is passed on as it is in the file for the receiver to decode. Turn it on only with a receiver or soundbar that takes those; without one there may be no sound.";
                        color: Theme.text-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                            }
                        }

                        // ---- Accounts: Trakt and Simkl, and your own keys.
                        if root.settings-section == 1: VerticalLayout {
                            spacing: 20px;
                            SettingsCard {
                                title: "Tracking";
                                note: "Link Trakt and Haven marks what you finish as watched there and keeps your watchlist in step. Linking opens trakt.tv in your web browser: sign in, choose Yes, and Haven picks it up by itself.";
                    for row in root.tracking: SettingsRow {
                        label: row.name;
                        detail: row.state;
                        HorizontalLayout {
                            spacing: 8px;
                            if row.connected: Button {
                                text: "Import watchlist";
                                enabled: !root.tracking-busy;
                                clicked => { root.tracking-import(row.service); }
                            }
                            if row.connected: Button {
                                text: "Unlink";
                                enabled: !root.tracking-busy;
                                clicked => { root.tracking-disconnect(row.service); }
                            }
                            if !row.connected: PrimaryButton {
                                text: "Link";
                                enabled: row.can-connect && !root.tracking-busy;
                                clicked => { root.tracking-connect(row.service); }
                            }
                        }
                    }
                    if root.tracking-busy: HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        if root.tracking-code != "": Text {
                            text: "Code: " + root.tracking-code;
                            color: Theme.accent;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if root.tracking-link != "": Button {
                            text: "Open the sign-in page again";
                            clicked => { root.open-link(root.tracking-link); }
                        }
                        Button {
                            text: "Cancel";
                            clicked => { root.tracking-cancel(); }
                        }
                    }
                    if root.tracking-status != "": Text {
                        text: root.tracking-status;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                            }
                            HorizontalLayout {
                                alignment: start;
                                Chip {
                                    label: root.keys-open ? "Hide your own keys" : "Advanced: use your own keys";
                                    selected: root.keys-open;
                                    clicked => { root.keys-open = !root.keys-open; }
                                }
                            }
                            if root.keys-open: SettingsCard {
                                title: "Your own keys";
                    Text {
                        text: (root.tmdb-built-in
                            ? "Your own keys for outside services. Haven comes with its own TMDB key for the catalogue (shelves on Home, the TMDB source in Explore, posters and pictures), so you can leave the TMDB box empty, or put your own key in to use that instead. A key is free from themoviedb.org: either the API key or the API read access token works."
                            : "Your own keys for outside services. A TMDB key turns on the built-in catalogue (shelves on Home, the TMDB source in Explore, posters and pictures) and fills in missing details. It is free from themoviedb.org: either the API key or the API read access token works.")
                            + " You do not need Trakt or Simkl keys to link those accounts: only fill them in to use an app of your own.";
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    GridLayout {
                        spacing: 8px;
                        Row {
                            Text {
                                text: "TMDB API key";
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            Field {
                                text <=> root.keys-tmdb;
                                input-type: password;
                                accessible-label: "TMDB API key";
                            }
                        }
                        Row {
                            Text {
                                text: "Trakt client ID";
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            Field {
                                text <=> root.keys-trakt-id;
                                accessible-label: "Trakt client ID";
                            }
                        }
                        Row {
                            Text {
                                text: "Trakt client secret";
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            Field {
                                text <=> root.keys-trakt-secret;
                                input-type: password;
                                accessible-label: "Trakt client secret";
                            }
                        }
                        Row {
                            Text {
                                text: "Simkl client ID";
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            Field {
                                text <=> root.keys-simkl-id;
                                accessible-label: "Simkl client ID";
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        PrimaryButton {
                            text: "Save keys";
                            clicked => { root.save-keys(); }
                        }
                        Text {
                            text: root.keys-status;
                            color: Theme.text-dim;
                            vertical-alignment: center;
                        }
                    }
                            }
                        }

                        // ---- Sync options
                        if root.settings-section == 7: VerticalLayout {
                            spacing: 20px;
                            // Red with the number of changes still to send;
                            // green once everything is in step. Tap to sync.
                            HorizontalLayout {
                                alignment: start;
                                spacing: 12px;
                                sync-pill := Rectangle {
                                    private property <bool> green: root.sync-linked && root.sync-waiting == 0 && !root.sync-problem && !root.sync-busy;
                                    private property <color> tone: !root.sync-linked ? Theme.text-dim : root.sync-busy ? Theme.accent : self.green ? #3ecf6e : #ef4b4b;
                                    height: 44px;
                                    width: sync-pill-row.preferred-width;
                                    border-radius: 22px;
                                    background: self.tone.with-alpha(sync-pill-touch.pressed ? 0.30 : 0.16);
                                    border-width: 1.5px;
                                    border-color: self.tone;
                                    accessible-role: button;
                                    accessible-label: self.green ? "Synced" : root.sync-waiting > 0 ? "Sync, " + root.sync-waiting + " out of sync" : "Sync now";
                                    accessible-action-default => { root.sync-now(); }
                                    sync-pill-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        enabled: root.sync-linked && !root.sync-busy;
                                        clicked => { root.sync-now(); }
                                    }
                                    sync-pill-row := HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 16px;
                                        spacing: 8px;
                                        Icon {
                                            y: (parent.height - self.height) / 2;
                                            name: sync-pill.green ? "check" : "sync";
                                            size: 20px;
                                            tint: sync-pill.tone;
                                            transform-rotation: root.sync-busy ? animation-tick() / 0.9s * 360deg : 0deg;
                                        }
                                        Text {
                                            text: root.sync-busy ? "Syncing…" : sync-pill.green ? "Synced" : "Sync";
                                            color: sync-pill.tone;
                                            font-size: 15px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        if root.sync-waiting > 0 && !root.sync-busy: Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            height: 22px;
                                            width: max(22px, sync-count.preferred-width + 12px);
                                            border-radius: 11px;
                                            background: #ef4b4b;
                                            sync-count := Text {
                                                text: root.sync-waiting;
                                                color: #ffffff;
                                                font-size: 12px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                            Text {
                                text: root.sync-status;
                                color: Theme.text-dim;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            SettingsCard {
                                title: "On this device";
                                note: root.sync-note;
                                SettingsRow {
                                    label: "Local (works offline)";
                                    detail: "What you watch and your Watchlist are always kept here first, with or without a connection, and sent on to the accounts below.";
                                    Rectangle {
                                        width: 56px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: #3ecf6e.with-alpha(0.16);
                                        border-width: 1px;
                                        border-color: #3ecf6e;
                                        Text {
                                            text: "On";
                                            color: #3ecf6e;
                                            font-size: 13px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            SettingsCard {
                                title: "Your accounts";
                                note: "Linking an account switches its sync on.";
                                for account in root.sync-accounts: SettingsRow {
                                    label: account.name;
                                    detail: account.detail;
                                    if account.linked: Switch {
                                        checked: account.on;
                                        accessible-label: "Sync with " + account.name;
                                        toggled => { root.sync-account(account.service, self.checked); }
                                    }
                                    if !account.linked: Chip {
                                        label: "Link  ›";
                                        clicked => {
                                            root.settings-section = 1;
                                            root.settings-scroll = 0px;
                                        }
                                    }
                                }
                            }
                        }

                        // ---- Media servers
                        if root.settings-section == 2: VerticalLayout {
                            spacing: 20px;
                            SettingsCard {
                    Text {
                        text: "Sign in to your own Jellyfin, Emby or Plex server. Its libraries then show as shelves on Home, in Explore and in Search, and it is offered as a place to watch whatever it holds.";
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        for name[index] in ["Jellyfin", "Emby", "Plex"]: Chip {
                            label: name;
                            selected: root.server-kind == index;
                            clicked => {
                                if (!root.server-busy) {
                                    root.server-kind = index;
                                }
                            }
                        }
                    }
                    if !root.compact && (root.server-kind != 2): HorizontalLayout {
                        spacing: 8px;
                        Field {
                            horizontal-stretch: 3;
                            text <=> root.server-address;
                            placeholder-text: "Server address, for example 192.168.1.10:8096";
                            enabled: !root.server-busy;
                            accessible-label: "Server address";
                        }
                        Field {
                            horizontal-stretch: 2;
                            text <=> root.server-user;
                            placeholder-text: "User name";
                            enabled: !root.server-busy;
                            accessible-label: "User name";
                        }
                        Field {
                            horizontal-stretch: 2;
                            text <=> root.server-password;
                            placeholder-text: "Password";
                            input-type: password;
                            enabled: !root.server-busy;
                            accessible-label: "Password";
                            accepted => { root.server-sign-in(root.server-kind, root.server-address, root.server-user, root.server-password); }
                        }
                        PrimaryButton {
                            text: root.server-busy ? "Signing in…" : "Sign in";
                            enabled: !root.server-busy && root.server-address != "" && root.server-user != "";
                            clicked => { root.server-sign-in(root.server-kind, root.server-address, root.server-user, root.server-password); }
                        }
                    }
                    if root.compact && (root.server-kind != 2): VerticalLayout {
                        spacing: 8px;
                        Field {
                            text <=> root.server-address;
                            placeholder-text: "Server address, for example 192.168.1.10:8096";
                            enabled: !root.server-busy;
                            accessible-label: "Server address";
                        }
                        Field {
                            text <=> root.server-user;
                            placeholder-text: "User name";
                            enabled: !root.server-busy;
                            accessible-label: "User name";
                        }
                        Field {
                            text <=> root.server-password;
                            placeholder-text: "Password";
                            input-type: password;
                            enabled: !root.server-busy;
                            accessible-label: "Password";
                            accepted => { root.server-sign-in(root.server-kind, root.server-address, root.server-user, root.server-password); }
                        }
                        PrimaryButton {
                            text: root.server-busy ? "Signing in…" : "Sign in";
                            enabled: !root.server-busy && root.server-address != "" && root.server-user != "";
                            clicked => { root.server-sign-in(root.server-kind, root.server-address, root.server-user, root.server-password); }
                        }
                    }
                    if root.server-kind == 2: HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        PrimaryButton {
                            text: root.server-busy ? "Waiting for Plex…" : "Sign in with Plex";
                            enabled: !root.server-busy;
                            clicked => { root.plex-sign-in(); }
                        }
                        if root.server-busy: Button {
                            text: "Cancel";
                            clicked => { root.plex-cancel(); }
                        }
                        if root.plex-code != "": Text {
                            text: "Code: " + root.plex-code;
                            color: Theme.accent;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if root.plex-link != "": Button {
                            text: "Open the Plex page again";
                            clicked => { root.open-link(root.plex-link); }
                        }
                    }
                    if root.server-status != "": Text {
                        text: root.server-status;
                        color: root.server-status-is-error ? (Theme.dark ? #ff8b8b : #b3261e) : Theme.text-dim;
                        wrap: word-wrap;
                    }
                    if root.servers.length == 0: Text {
                        text: "No media servers added yet.";
                        color: Theme.text-dim;
                    }
                    for server in root.servers: SettingsRow {
                        label: server.name;
                        detail: server.kind + "  ·  " + server.address;
                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                width: 10px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: !server.enabled ? Theme.text-dim : server.state == 1 ? #3fbf6f : server.state == 2 ? #e0564f : Theme.text-dim;
                                }
                            }
                            Text {
                                text: !server.enabled ? "Switched off" : server.state == 1 ? "Online" : server.state == 2 ? "Offline" : "Checking…";
                                color: !server.enabled ? Theme.text-dim : server.state == 1 ? (Theme.dark ? #6fdc97 : #1f8a4a) : server.state == 2 ? (Theme.dark ? #ff8b8b : #b3261e) : Theme.text-dim;
                                font-weight: 600;
                                vertical-alignment: center;
                                accessible-label: server.name + " is " + self.text;
                            }
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked: server.enabled;
                                    accessible-label: "Use " + server.name;
                                    toggled => { root.set-server-enabled(server.id, self.checked); }
                                }
                            }
                            Button {
                                text: "Remove";
                                accessible-label: "Remove " + server.name;
                                clicked => { root.remove-server(server.id); }
                            }
                        }
                    }
                    if root.servers.length > 0: HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "Check again";
                            clicked => { root.check-servers(); }
                        }
                    }
                            }
                        }

                        // ---- Add-ons
                        if root.settings-section == 3: VerticalLayout {
                            spacing: 12px;
                    Text {
                        text: "Paste an add-on's address to install it. Its catalogues show up as shelves on Home. Cinemeta, a free catalogue of films and series, comes installed; switch it off or remove it if you do not want it.";
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Field {
                            text <=> root.addon-address;
                            placeholder-text: "https://…/manifest.json";
                            enabled: !root.addon-busy;
                            accessible-label: "Add-on address";
                            accepted(text) => { root.install-addon(text); }
                        }
                        PrimaryButton {
                            text: root.addon-busy ? "Installing…" : "Install";
                            enabled: !root.addon-busy && root.addon-address != "";
                            clicked => { root.install-addon(root.addon-address); }
                        }
                    }
                    if root.addon-status != "": Text {
                        text: root.addon-status;
                        color: root.addon-status-is-error ? (Theme.dark ? #ff8b8b : #b3261e) : Theme.text-dim;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 4px; }
                    if root.addons.length == 0: Text {
                        text: "No add-ons installed yet.";
                        color: Theme.text-dim;
                    }
                    for addon in root.addons: AddonCard {
                        addon: addon;
                        remove => { root.remove-addon(addon.url); }
                        switched(on) => { root.set-addon-enabled(addon.url, on); }
                    }
                    if root.shared-addons.length > 0: Rectangle { height: 8px; }
                    if root.shared-addons.length > 0: SectionTitle { text: "From your media servers"; }
                    if root.shared-addons.length > 0: Text {
                        text: "These add-ons are set up on a media server of yours. The server already uses them for what it shows and plays in Haven. Install one here as well if you want Haven to ask it directly.";
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    if root.shared-addons.length > 0: HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "Install all";
                            enabled: !root.addon-busy;
                            clicked => { root.install-shared(-1); }
                        }
                    }
                    for shared in root.shared-addons: SettingsRow {
                        label: shared.name;
                        detail: "On " + shared.server;
                        Button {
                            text: shared.installed ? "Installed" : "Install";
                            enabled: !shared.installed && !root.addon-busy;
                            accessible-label: "Install " + shared.name;
                            clicked => { root.install-shared(shared.index); }
                        }
                    }
                        }

                        // ---- Live TV sources
                        if root.settings-section == 4: VerticalLayout {
                            spacing: 20px;
                            SettingsCard {
                    Text {
                        text: "Add your TV provider's channels, either as the address of an M3U playlist or as an Xtream Codes account (server address, user name and password). The channels then show on the Live TV tab, and radio stations on Radio.";
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Field {
                            text <=> root.tv-address;
                            placeholder-text: "M3U playlist address, for example https://…/playlist.m3u";
                            enabled: !root.tv-busy;
                            accessible-label: "M3U playlist address";
                            accepted(text) => { root.add-tv-source(text); }
                        }
                        PrimaryButton {
                            text: root.tv-busy ? "Adding…" : "Add playlist";
                            enabled: !root.tv-busy && root.tv-address != "";
                            clicked => { root.add-tv-source(root.tv-address); }
                        }
                    }
                    if root.tv-status != "": Text {
                        text: root.tv-status;
                        color: root.tv-status-is-error ? (Theme.dark ? #ff8b8b : #b3261e) : Theme.text-dim;
                        wrap: word-wrap;
                    }
                    if !root.compact: HorizontalLayout {
                        spacing: 8px;
                        Field {
                            horizontal-stretch: 3;
                            text <=> root.xtream-server;
                            placeholder-text: "Server address, for example http://tv.example.com:8080";
                            enabled: !root.xtream-busy;
                            accessible-label: "Xtream Codes server address";
                        }
                        Field {
                            horizontal-stretch: 2;
                            text <=> root.xtream-user;
                            placeholder-text: "User name";
                            enabled: !root.xtream-busy;
                            accessible-label: "Xtream Codes user name";
                        }
                        Field {
                            horizontal-stretch: 2;
                            text <=> root.xtream-password;
                            placeholder-text: "Password";
                            input-type: password;
                            enabled: !root.xtream-busy;
                            accessible-label: "Xtream Codes password";
                            accepted => { root.add-xtream(root.xtream-server, root.xtream-user, root.xtream-password); }
                        }
                        PrimaryButton {
                            text: root.xtream-busy ? "Adding…" : "Add account";
                            enabled: !root.xtream-busy && root.xtream-server != "" && root.xtream-user != "" && root.xtream-password != "";
                            clicked => { root.add-xtream(root.xtream-server, root.xtream-user, root.xtream-password); }
                        }
                    }
                    if root.compact: VerticalLayout {
                        spacing: 8px;
                        Field {
                            text <=> root.xtream-server;
                            placeholder-text: "Server address, for example http://tv.example.com:8080";
                            enabled: !root.xtream-busy;
                            accessible-label: "Xtream Codes server address";
                        }
                        Field {
                            text <=> root.xtream-user;
                            placeholder-text: "User name";
                            enabled: !root.xtream-busy;
                            accessible-label: "Xtream Codes user name";
                        }
                        Field {
                            text <=> root.xtream-password;
                            placeholder-text: "Password";
                            input-type: password;
                            enabled: !root.xtream-busy;
                            accessible-label: "Xtream Codes password";
                            accepted => { root.add-xtream(root.xtream-server, root.xtream-user, root.xtream-password); }
                        }
                        PrimaryButton {
                            text: root.xtream-busy ? "Adding…" : "Add account";
                            enabled: !root.xtream-busy && root.xtream-server != "" && root.xtream-user != "" && root.xtream-password != "";
                            clicked => { root.add-xtream(root.xtream-server, root.xtream-user, root.xtream-password); }
                        }
                    }
                    if root.xtream-status != "": Text {
                        text: root.xtream-status;
                        color: root.xtream-status-is-error ? (Theme.dark ? #ff8b8b : #b3261e) : Theme.text-dim;
                        wrap: word-wrap;
                    }
                    for source in root.tv-sources: SettingsRow {
                        label: source.name;
                        detail: (source.channels == 1 ? "1 entry" : source.channels + " entries") + "  ·  " + source.detail;
                        HorizontalLayout {
                            spacing: 12px;
                            if source.state != 0: Rectangle {
                                width: 10px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: source.state == 2 ? #3fbf6f : source.state == 3 ? #e0564f : Theme.text-dim;
                                }
                            }
                            if source.state != 0 || !source.enabled: Text {
                                text: !source.enabled ? "Switched off" : source.state == 2 ? "Online" : source.state == 3 ? "Offline" : "Checking…";
                                color: !source.enabled ? Theme.text-dim : source.state == 2 ? (Theme.dark ? #6fdc97 : #1f8a4a) : source.state == 3 ? (Theme.dark ? #ff8b8b : #b3261e) : Theme.text-dim;
                                font-weight: 600;
                                vertical-alignment: center;
                                accessible-label: source.name + " is " + self.text;
                            }
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked: source.enabled;
                                    accessible-label: "Use " + source.name;
                                    toggled => { root.set-tv-source-enabled(source.url, self.checked); }
                                }
                            }
                            Button {
                                text: "Remove";
                                accessible-label: "Remove " + source.name;
                                clicked => { root.remove-tv-source(source.url); }
                            }
                        }
                    }
                            }
                        }

                        // ---- Downloads and storage
                        if root.settings-section == 5: VerticalLayout {
                            spacing: 20px;
                            SettingsCard {
                                title: "Downloads";
                                note: "Films are saved in Movies and series in Series, one folder per show and season. Deleting a download in Haven deletes its file too.";
                                SettingsRow {
                                    label: "Downloads folder";
                                    detail: root.downloads-folder;
                                    if !root.mobile: Button {
                                        text: "Show folder";
                                        clicked => { root.open-downloads-folder(); }
                                    }
                                }
                                SettingsRow {
                                    label: "Downloads";
                                    detail: root.downloads-count == 1 ? "1 film or episode" : root.downloads-count + " films and episodes";
                                    Button {
                                        text: "Open in Library";
                                        clicked => {
                                            root.library-tab = 0;
                                            root.page = root.library-page;
                                            root.page-selected(root.library-page);
                                        }
                                    }
                                }
                            }
                            SettingsCard {
                                title: "Storage";
                    SettingsRow {
                        label: "Picture cache";
                        detail: root.cache-status;
                        Button {
                            text: "Clear cache";
                            clicked => { root.clear-cache(); }
                        }
                    }
                    Text {
                        text: "Posters and other pictures are kept on this computer once fetched, so they show at once the next time. Clearing the cache only removes those copies; they are fetched again when needed.";
                        color: Theme.text-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                            }
                        }

                        // ---- About
                        if root.settings-section == 6: VerticalLayout {
                            spacing: 20px;
                            SettingsCard {
                    SettingsRow {
                        label: "Data folder";
                        detail: root.data-path;
                    }
                    SettingsRow {
                        label: "Log file";
                        detail: root.log-path;
                    }
                    SettingsRow {
                        label: "Version";
                        detail: root.version;
                    }
                    if !root.mobile: Rectangle {
                        height: 64px;
                        border-radius: 10px;
                        background: transparent;
                        border-width: 0px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "Updates";
                                    color: Theme.text;
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.update-status != "" ? root.update-status : "Haven looks for a newer version when it starts.";
                                    color: root.update-version != "" ? Theme.accent : Theme.text-dim;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 8px;
                                    if root.update-version != "": PrimaryButton {
                                        text: "Install Haven " + root.update-version;
                                        enabled: !root.update-busy;
                                        clicked => { root.install-update(); }
                                    }
                                    Button {
                                        text: "Check for updates";
                                        enabled: !root.update-busy;
                                        clicked => { root.check-updates(); }
                                    }
                                }
                            }
                        }
                    }
                    if !root.mobile && root.update-notes.length > 0: Rectangle {
                        border-radius: 10px;
                        background: transparent;
                        border-width: 0px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Text {
                                text: "What's new in Haven " + root.update-notes-version;
                                color: Theme.text;
                                font-weight: 600;
                            }
                            for line in root.update-notes: HorizontalLayout {
                                padding-left: line.deep ? 20px : 0px;
                                spacing: 8px;
                                if line.bullet: Text {
                                    text: "•";
                                    color: Theme.accent;
                                    font-size: 13px;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: line.text == "" ? " " : line.text;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    if !root.mobile: Rectangle {
                        height: 52px;
                        border-radius: 10px;
                        background: transparent;
                        border-width: 0px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            Text {
                                horizontal-stretch: 1;
                                text: "Look for a newer Haven when it starts";
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked <=> root.update-check-at-start;
                                    toggled => { root.set-update-check(self.checked); }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 52px;
                        border-radius: 10px;
                        background: transparent;
                        border-width: 0px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            Text {
                                horizontal-stretch: 1;
                                text: "Something not working? Tell us on GitHub.";
                                color: Theme.text;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 34px;
                                    width: report-label.preferred-width + 32px;
                                    border-radius: 17px;
                                    background: report-touch.pressed ? Theme.alert.darker(0.2) : report-touch.has-hover ? Theme.alert.brighter(0.12) : Theme.alert;
                                    accessible-role: button;
                                    accessible-label: "Report an issue";
                                    accessible-action-default => { root.report-issue(); }
                                    report-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.report-issue(); }
                                    }
                                    report-label := Text {
                                        text: "Report an issue";
                                        color: #ffffff;
                                        font-weight: 700;
                                        font-size: 13px;
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: "Haven © 2026 TinusTK. Free software under the GNU GPL version 3.\nMade with Slint. Video playback by mpv (libmpv, LGPL).\nThis product uses the TMDB API but is not endorsed or certified by TMDB.";
                        color: Theme.text-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                            }
                        }
                    }
                }
            }
        }
    }
        // Along the bottom: Haven's pages as icon buttons on a floating
        // bar, and Settings as a round button beside it.
        if !root.player-open: nav-strip := Rectangle {
            height: root.nav-height;
            background: Theme.background;
            if !root.compact && self.width > 1080px: HorizontalLayout {
                x: 24px;
                y: 18px;
                height: 56px;
                spacing: 8px;
                Image {
                    width: 48px;
                    height: 48px;
                    y: 4px;
                    source: @image-url("../../../assets/icon/haven.png");
                    image-fit: contain;
                    image-rendering: smooth;
                    accessible-role: none;
                }
                Text {
                    text: "Haven";
                    font-family: Theme.heading-font;
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            nav-bar := Rectangle {
                private property <int> count: root.compact ? 6 : 5;
                private property <length> button: root.compact ? (parent.width - 24px - 10px) / 6 : 92px;
                width: self.count * self.button + 10px;
                height: 66px;
                x: root.compact ? 12px : (parent.width - self.width - 78px) / 2;
                y: root.compact ? 6px : 13px;
                border-radius: 33px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 22px;
                drop-shadow-offset-y: 6px;
                drop-shadow-color: Theme.dark ? #00000080 : #00000026;
                HorizontalLayout {
                    padding: 5px;
                    for tab[index] in [
                        { icon: "home", label: "Home" },
                        { icon: "explore", label: "Explore" },
                        { icon: "library", label: "Library" },
                        { icon: "livetv", label: "Live TV" },
                        { icon: "calendar", label: "Calendar" },
                    ]: NavButton {
                        width: nav-bar.button;
                        icon: tab.icon;
                        label: tab.label;
                        selected: !root.detail-open && root.page == index;
                        clicked => {
                            root.close-detail();
                            root.page = index;
                            root.page-selected(index);
                        }
                    }
                    if root.compact: NavButton {
                        width: nav-bar.button;
                        icon: "settings";
                        label: "Settings";
                        selected: !root.detail-open && root.page == root.settings-page;
                        clicked => {
                            // Tapped again while in Settings: back to its start.
                            if (!root.detail-open && root.page == root.settings-page) {
                                root.settings-picking = true;
                                root.settings-section = 0;
                            }
                            root.close-detail();
                            root.page = root.settings-page;
                            root.page-selected(root.settings-page);
                        }
                    }
                }
            }
            if !root.compact: Rectangle {
                x: nav-bar.x + nav-bar.width + 12px;
                y: nav-bar.y;
                width: 66px;
                height: 66px;
                border-radius: 33px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 22px;
                drop-shadow-offset-y: 6px;
                drop-shadow-color: Theme.dark ? #00000080 : #00000026;
                NavButton {
                    x: 5px;
                    y: 5px;
                    width: 56px;
                    height: 56px;
                    icon: "settings";
                    label: "";
                    accessible-label: "Settings";
                    selected: !root.detail-open && root.page == root.settings-page;
                    clicked => {
                        // Clicked again while in Settings: back to its start.
                        if (!root.detail-open && root.page == root.settings-page) {
                            root.settings-picking = true;
                            root.settings-section = 0;
                        }
                        root.close-detail();
                        root.page = root.settings-page;
                        root.page-selected(root.settings-page);
                    }
                }
            }
            if !root.compact && root.update-version != "": Rectangle {
                width: update-text.preferred-width + 32px;
                height: 40px;
                x: parent.width - self.width - 24px;
                y: nav-bar.y + 13px;
                border-radius: 20px;
                background: update-touch.has-hover ? Theme.accent : Theme.accent.with-alpha(0.16);
                border-width: 1px;
                border-color: Theme.accent;
                accessible-role: button;
                accessible-label: "Install Haven " + root.update-version;
                update-touch := TouchArea {
                    mouse-cursor: pointer;
                    enabled: !root.update-busy;
                    clicked => { root.install-update(); }
                }
                update-text := Text {
                    text: root.update-busy ? "Updating…" : "Update  ·  " + root.update-version;
                    color: update-touch.has-hover ? (Theme.dark ? #171a22 : #ffffff) : Theme.accent;
                    font-size: 13px;
                    font-weight: 600;
                }
            }
        }
    }

    // Choosing the Favourites groups of one channel, over the page.
    if root.fav-open && !root.player-open: Rectangle {
        background: #000000a0;
        TouchArea {
            clicked => { root.fav-close(); }
        }
        Rectangle {
            width: 440px;
            height: min(parent.height - 80px, fav-box.preferred-height);
            border-radius: 12px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            TouchArea { }
            fav-box := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                alignment: start;
                Text {
                    text: "Favourites";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 600;
                }
                Text {
                    text: root.fav-channel;
                    color: Theme.text-dim;
                    overflow: elide;
                }
                if root.fav-picks.length == 0: Text {
                    text: "You have no Favourites groups yet. Name one below and this channel goes into it.";
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                for pick in root.fav-picks: SideItem {
                    label: pick.name;
                    trailing: pick.has ? "✓  In this group" : "Add";
                    selected: pick.has;
                    star: true;
                    clicked => { root.fav-toggle(pick.name); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Field {
                        text <=> root.fav-new-name;
                        placeholder-text: "New group, for example Sport";
                        accessible-label: "Name of a new Favourites group";
                        accepted(text) => { root.fav-new-group(text); }
                    }
                    Button {
                        text: "New group";
                        enabled: root.fav-new-name != "";
                        clicked => { root.fav-new-group(root.fav-new-name); }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    PrimaryButton {
                        text: "Done";
                        clicked => { root.fav-close(); }
                    }
                }
            }
        }
    }

    // What is playing on a Chromecast, along the bottom of every page.
    if root.casting && !root.player-open: Rectangle {
        x: 0;
        y: parent.height - self.height - root.nav-height;
        width: parent.width;
        height: 64px;
        background: Theme.surface;
        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.border;
        }
        TouchArea { }
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.cast-title;
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.cast-status != "" ? root.cast-status : "On " + root.cast-device-name + (root.cast-time != "" ? "  ·  " + root.cast-time : "");
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "−10 s";
                        accessible-label: "Back 10 seconds";
                        clicked => { root.cast-command("back"); }
                    }
                    Button {
                        text: root.cast-paused ? "Play" : "Pause";
                        clicked => { root.cast-command("pause"); }
                    }
                    Button {
                        text: "+30 s";
                        accessible-label: "Forward 30 seconds";
                        clicked => { root.cast-command("forward"); }
                    }
                    Button {
                        text: "Stop";
                        clicked => { root.cast-command("stop"); }
                    }
                }
            }
        }
    }

    if root.player-open: PlayerView {
        frame: root.player-frame;
        title: root.player-title;
        subtitle: root.player-subtitle;
        paused: root.player-paused;
        busy: root.player-busy;
        error: root.player-error;
        duration: root.player-duration;
        position: root.player-position;
        elapsed-text: root.player-elapsed;
        remaining-text: root.player-remaining;
        ends-at: root.player-ends-at;
        net: root.player-net;
        buffered: root.player-buffered;
        volume: root.player-volume;
        muted: root.player-muted;
        speed: root.player-speed;
        fit: root.player-fit;
        subtitle-scale: root.player-subtitle-scale;
        subtitle-delay: root.player-subtitle-delay;
        info: root.player-info;
        next-title: root.player-next-title;
        next-countdown: root.player-next-countdown;
        audio-tracks: root.player-audio;
        subtitle-tracks: root.player-subtitles;
        any-subtitle: root.player-any-subtitle;
        fullscreen: root.player-fullscreen;
        menu <=> root.player-menu;
        close => { root.player-close(); }
        toggle-pause => { root.player-toggle-pause(); }
        seek(seconds) => { root.player-seek(seconds); }
        skip(seconds) => { root.player-skip(seconds); }
        choose-audio(id) => { root.player-choose-audio(id); }
        choose-subtitle(id) => { root.player-choose-subtitle(id); }
        toggle-fullscreen => { root.player-toggle-fullscreen(); }
        set-volume(volume) => { root.player-set-volume(volume); }
        toggle-mute => { root.player-toggle-mute(); }
        set-speed(speed) => { root.player-set-speed(speed); }
        set-fit(fit) => { root.player-set-fit(fit); }
        subtitle-scale-step(way) => { root.player-subtitle-scale-step(way); }
        subtitle-delay-step(way) => { root.player-subtitle-delay-step(way); }
        subtitle-sync(way) => { root.player-subtitle-sync(way); }
        next => { root.player-next(); }
        cancel-next => { root.player-cancel-next(); }
        controls-shown(shown) => { root.player-controls-shown(shown); }
    }

    // ---- The loading screen, over everything while Haven starts.
    in property <bool> splash-shown: true;
    in property <float> splash-progress;
    // Set once it has faded: then it is gone, and nothing keeps animating.
    in property <bool> splash-gone;
    if !root.splash-gone: splash := Rectangle {
        opacity: root.splash-shown ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 400ms; easing: ease-out; }
        background: Theme.background;
        // Nothing underneath can be touched while it shows.
        TouchArea { enabled: root.splash-shown; }
        // A slow pulse of light behind the halo.
        private property <float> beat: (sin(animation-tick() / 1.6s * 360deg) + 1) / 2;
        Rectangle {
            width: 300px;
            height: 300px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 60px;
            border-radius: 150px;
            background: @radial-gradient(circle, Theme.accent.with-alpha(0.10 + 0.14 * splash.beat) 0%, transparent 70%);
        }
        Image {
            width: 190px;
            height: 190px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 60px;
            source: @image-url("../../../assets/icon/haven.png");
            image-fit: contain;
            image-rendering: smooth;
            transform-rotation: animation-tick() / 12s * 360deg;
            opacity: 0.85 + 0.15 * splash.beat;
            accessible-role: none;
        }
        Text {
            x: 0;
            width: parent.width;
            y: parent.height / 2 + 62px;
            text: "Haven";
            font-family: Theme.heading-font;
            color: Theme.text;
            font-size: 30px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Rectangle {
            width: min(parent.width - 80px, 260px);
            height: 6px;
            x: (parent.width - self.width) / 2;
            y: parent.height / 2 + 118px;
            border-radius: 3px;
            background: Theme.border;
            accessible-role: progress-indicator;
            accessible-label: "Loading";
            accessible-value: round(root.splash-progress * 100) + "%";
            Rectangle {
                x: 0;
                width: parent.width * clamp(root.splash-progress, 0, 1);
                border-radius: 3px;
                background: Theme.accent;
                animate width { duration: 160ms; }
            }
        }
        Text {
            x: 0;
            width: parent.width;
            y: parent.height / 2 + 136px;
            text: root.splash-progress >= 1 ? "Ready" : "Loading…  " + round(root.splash-progress * 100) + "%";
            color: Theme.text-dim;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
}
